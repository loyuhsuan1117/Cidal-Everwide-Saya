#include <Wire.h>
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_Sensor.h>

Adafruit_LIS3MDL lis;

void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);

  Serial.println("--- LIS3MDL 磁力計測試 ---");

  Wire.begin();

  // 嘗試兩個可能的位址：0x1C 或 0x1E
  if (!lis.begin_I2C(0x1C) && !lis.begin_I2C(0x1E)) {
    Serial.println("❌ 找不到 LIS3MDL 感測器！");
    Serial.println("請檢查接線，或重新執行 I2C Scanner 確認位址。");
    while (1) delay(10);
  }

  Serial.println("✅ LIS3MDL 初始化成功！");

  // 設定參數
  lis.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
  lis.setOperationMode(LIS3MDL_CONTINUOUSMODE);
  lis.setDataRate(LIS3MDL_DATARATE_155_HZ);
  lis.setRange(LIS3MDL_RANGE_4_GAUSS);
}

void loop() {
  sensors_event_t event;
  lis.getEvent(&event);

  Serial.print("磁力計 X: "); Serial.print(event.magnetic.x);
  Serial.print(" | Y: "); Serial.print(event.magnetic.y);
  Serial.print(" | Z: "); Serial.print(event.magnetic.z);
  Serial.println(" uT");

  delay(500);
}
