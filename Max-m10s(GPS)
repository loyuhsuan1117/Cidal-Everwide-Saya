#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <SparkFun_u-blox_GNSS_Arduino_Library.h> 

const int chipSelect = BUILTIN_SDCARD; 
SFE_UBLOX_GNSS myGNSS;
const char* fileName = "gps_data.csv";

// --- 數據計數器 ---
unsigned long dataCount = 0; 

// 輔助函式：檢查檔案並初始化編號
void checkAndCreateFile() {
  if (!SD.exists(fileName)) {
    File dataFile = SD.open(fileName, FILE_WRITE);
    if (dataFile) {
      // 寫入 CSV 標題，加入 Index 欄位
      dataFile.println("Index,Date,Time,Latitude,Longitude,Altitude(m),Speed(km/h),SIV,PDOP");
      dataFile.close();
      Serial.println(F("建立新檔案並寫入標題。"));
      dataCount = 0;
    }
  } else {
    // 掃描舊檔案有幾行，讓編號續傳
    Serial.print(F("正在掃描舊檔案以同步編號... "));
    File dataFile = SD.open(fileName, FILE_READ);
    if (dataFile) {
      while (dataFile.available()) {
        if (dataFile.read() == '\n') dataCount++;
      }
      dataFile.close();
      if (dataCount > 0) dataCount--; // 扣除標題列
      Serial.print(F("目前已累積筆數: ")); Serial.println(dataCount);
    }
  }
}

void setup() {
  Serial.begin(115200);
  unsigned long startWait = millis();
  while (!Serial && (millis() - startWait < 2000)); 
  
  Serial.println(F("--- Teensy GPS 數據紀錄器 (編號續傳版) ---"));

  Wire.begin();
  if (myGNSS.begin() == false) {
    Serial.println(F("錯誤：找不到 GPS 模組。"));
    while (1);
  }
  
  myGNSS.setI2COutput(COM_TYPE_UBX); 
  myGNSS.setNavigationFrequency(5); 

  if (!SD.begin(chipSelect)) {
    Serial.println(F("SD 卡初始化失敗！"));
  } else {
    Serial.println(F("SD 卡初始化成功。"));
    checkAndCreateFile();
  }
}

void loop() {
  if (myGNSS.getPVT()) {
    // 每收到一次有效數據，編號 +1
    dataCount++;

    float lat = myGNSS.getLatitude() / 10000000.0;
    float lon = myGNSS.getLongitude() / 10000000.0;
    float altitude = myGNSS.getAltitude() / 1000.0;
    float speed = myGNSS.getGroundSpeed() * 0.0036;
    byte siv = myGNSS.getSIV();
    float pdop = myGNSS.getPDOP() / 100.0;

    // 螢幕輸出
    Serial.print(F("#")); Serial.print(dataCount);
    Serial.print(F(" | Sats: ")); Serial.print(siv);
    Serial.print(F(" | Lat: ")); Serial.println(lat, 6);

    // --- 寫入 SD 卡 ---
    File dataFile = SD.open(fileName, FILE_WRITE);
    if (dataFile) {
      // 萬一檔案中途被刪除，重新補標題與重設編號
      if (dataFile.size() == 0) {
        dataFile.println("Index,Date,Time,Latitude,Longitude,Altitude(m),Speed(km/h),SIV,PDOP");
        dataCount = 1;
      }

      // 1. 寫入編號
      dataFile.print(dataCount);
      dataFile.print(",");

      // 2. 寫入日期與時間 (補零處理)
      dataFile.print(myGNSS.getYear()); dataFile.print("/");
      dataFile.print(myGNSS.getMonth()); dataFile.print("/");
      dataFile.print(myGNSS.getDay()); dataFile.print(",");
      
      if (myGNSS.getHour() < 10) dataFile.print("0");
      dataFile.print(myGNSS.getHour()); dataFile.print(":");
      if (myGNSS.getMinute() < 10) dataFile.print("0");
      dataFile.print(myGNSS.getMinute()); dataFile.print(":");
      if (myGNSS.getSecond() < 10) dataFile.print("0");
      dataFile.print(myGNSS.getSecond()); dataFile.print(",");

      // 3. 寫入地理資訊
      dataFile.print(lat, 7); dataFile.print(",");
      dataFile.print(lon, 7); dataFile.print(",");
      dataFile.print(altitude, 2); dataFile.print(",");
      dataFile.print(speed, 2); dataFile.print(",");
      dataFile.print(siv); dataFile.print(",");
      dataFile.println(pdop);

      dataFile.close(); 
    } else {
      Serial.println(F("SD 寫入失敗，嘗試重連..."));
      SD.begin(chipSelect);
    }
  }

  delay(200); 
}
