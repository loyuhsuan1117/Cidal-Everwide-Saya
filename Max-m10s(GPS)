#include <Wire.h>
#include <SparkFun_u-blox_GNSS_Arduino_Library.h> // 請安裝此函式庫

SFE_UBLOX_GNSS myGNSS;

void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);

  Serial.println(F("--- MAX-M10S GPS 測試 ---"));

  Wire.begin();
  Wire.setClock(400000); // GPS 支援高速 I2C

  // 嘗試連線至 GPS (預設 I2C 位址為 0x42)
  if (myGNSS.begin() == false) {
    Serial.println(F("❌ 找不到 u-blox GNSS 模組！"));
    Serial.println(F("請檢查接線，或確認模組是否支援 I2C 通訊。"));
    while (1) delay(10);
  }

  Serial.println(F("✅ GPS 初始化成功！"));

  // 設定輸出為 UBX 格式 (更高效)
  myGNSS.setI2COutput(COM_TYPE_UBX);
  // 設定導航更新頻率為 5Hz (每秒 5 次)
  myGNSS.setNavigationFrequency(5);
}

void loop() {
  // 檢查是否有新數據
  if (myGNSS.getPVT()) {
    long latitude = myGNSS.getLatitude();   // 緯度 (度 * 10^-7)
    long longitude = myGNSS.getLongitude(); // 經度 (度 * 10^-7)
    long altitude = myGNSS.getAltitude();   // 高度 (mm)
    byte SIV = myGNSS.getSIV();             // 衛星數量

    Serial.print(F("衛星數(SIV): "));
    Serial.print(SIV);
    
    if (SIV > 0) {
      Serial.print(F(" | 緯度: ")); Serial.print(latitude / 10000000.0, 7);
      Serial.print(F(" | 經度: ")); Serial.print(longitude / 10000000.0, 7);
      Serial.print(F(" | 高度: ")); Serial.print(altitude / 1000.0, 2);
      Serial.println(F(" m"));
    } else {
      Serial.println(F(" | 等待定位中 (尚未抓到衛星)..."));
    }
  }

  delay(200);
}
