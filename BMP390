#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BMP3XX.h>
#include <SPI.h>
#include <SD.h>
#include <math.h> // 引入數學庫以使用 pow()


// ===== 你的 SD 接線 =====
#define SD_CS   15
#define SD_SCK  14
#define SD_MISO 12
#define SD_MOSI 13


// ===== 海平面氣壓設定 (hPa) =====
// 標準值為 1013.25，若要更準確，請填入當地的海平面氣壓
#define SEALEVELPRESSURE_HPA (1013.25)


Adafruit_BMP3XX bmp;
File dataFile;


void setup() {
  Serial.begin(115200);
  Wire.begin(8, 9); // BMP390 I2C


  if (!bmp.begin_I2C()) {
    Serial.println("BMP390 初始化失敗");
    while (1);
  }


  bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);
  bmp.setPressureOversampling(BMP3_OVERSAMPLING_8X);
  bmp.setIIRFilterCoeff(BMP3_IIR_FILTER_COEFF_3);


  Serial.println("BMP390 初始化成功");


  // 暖機
  for (int i = 0; i < 5; i++) {
    bmp.performReading();
    delay(100);
  }


  SPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);


  if (!SD.begin(SD_CS)) {
    Serial.println("SD 卡初始化失敗");
    return;
  }
 
  // 建立檔案並更新標題列（增加 Altitude 欄位）
  dataFile = SD.open("/bmp390.csv", FILE_WRITE);
  if (dataFile) {
    dataFile.println("Time_ms,Temperature_C,Pressure_hPa,Altitude_m");
    dataFile.close();
  }
}


void loop() {
  if (!bmp.performReading()) {
    Serial.println("BMP390 讀取失敗");
    delay(100);
    return;
  }


  float temperature = bmp.temperature; // T
  float pressure = bmp.pressure / 100.0; // P (hPa)


  // ===== 根據公式計算高度 h =====
  // h = [((P0/P)^(1/5.257)) - 1] * (T + 273.15) / 0.0065
  float exponent = 1.0 / 5.257;
  float altitude = (pow((1016.2 / pressure), exponent) - 1.0) * (temperature + 273.15) / 0.0065;


  // 序列輸出
  Serial.print("Temperature °C: "); Serial.println(temperature);
  Serial.print("Pressure hPa: "); Serial.println(pressure);
  Serial.print("Altitude m: "); Serial.println(altitude);
  Serial.println("-----------------");


  // 寫入 SD
  dataFile = SD.open("/bmp390.csv", FILE_APPEND);
  if (dataFile) {
    dataFile.print(millis());
    dataFile.print(",");
    dataFile.print(temperature, 3);
    dataFile.print(",");
    dataFile.print(pressure, 3);
    dataFile.print(",");
    dataFile.println(altitude, 3); // 寫入高度
    dataFile.close();
    Serial.println("寫入 SD 成功");
  } else {
    Serial.println("開檔失敗");
  }


  delay(500);
}
