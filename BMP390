#include <Wire.h>

#include <Adafruit_Sensor.h>

#include <Adafruit_BMP3XX.h>

#include <SPI.h>

#include <SD.h>





// ===== 你的 SD 接線 =====

#define SD_CS   15

#define SD_SCK  14

#define SD_MISO 12

#define SD_MOSI 13





Adafruit_BMP3XX bmp;

File dataFile;





void setup() {

  Serial.begin(115200);

  Wire.begin(8, 9); // BMP390 I2C





  // ===== BMP390 初始化 =====

  if (!bmp.begin_I2C()) {

    Serial.println("BMP390 初始化失敗");

    while (1);

  }





  bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);

  bmp.setPressureOversampling(BMP3_OVERSAMPLING_8X);

  bmp.setIIRFilterCoeff(BMP3_IIR_FILTER_COEFF_3);





  Serial.println("BMP390 初始化成功");





  // ===== 暖機讀取，不記錄 =====

  Serial.println("BMP390 暖機中...");

  for (int i = 0; i < 5; i++) {

    bmp.performReading();

    delay(100);

  }

  Serial.println("暖機完成");





  // ===== SPI 啟動 =====

  SPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);





  Serial.println("初始化 SD 卡中...");

  if (!SD.begin(SD_CS)) {

    Serial.println("SD 卡初始化失敗");

    return;

  }

  Serial.println("SD 卡初始化成功");





  // 建立檔案與標題列

  dataFile = SD.open("/bmp390.csv", FILE_WRITE);

  if (dataFile) {

    dataFile.println("Time_ms,Temperature_C,Pressure_hPa");

    dataFile.close();

  }

}





void loop() {

  if (!bmp.performReading()) {

    Serial.println("BMP390 讀取失敗");

    delay(100);

    return;

  }





  float temperature = bmp.temperature;

  float pressure = bmp.pressure / 100.0;





  // 序列輸出

  Serial.print("Temperature °C: "); Serial.println(temperature);

  Serial.print("Pressure hPa: "); Serial.println(pressure);

  Serial.println("-----------------");





  // 寫入 SD

  dataFile = SD.open("/bmp390.csv", FILE_APPEND);

  if (dataFile) {

    dataFile.print(millis());

    dataFile.print(",");

    dataFile.print(temperature, 3);

    dataFile.print(",");

    dataFile.println(pressure, 3);

    dataFile.close();

    Serial.println("寫入 SD 成功");

  } else {

    Serial.println("開檔失敗");

  }





  delay(500);

}
