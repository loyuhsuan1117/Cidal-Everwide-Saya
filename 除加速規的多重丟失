#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <TinyGPS++.h>
#include <MS5611.h>
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_Sensor.h>

// ==========================================
// 🌟 硬體腳位與引腳定義 (RP2040 Pico)
// ==========================================
#define I2C_SDA_PIN 4
#define I2C_SCL_PIN 5

#define SD_MISO_PIN 16
#define SD_MOSI_PIN 19
#define SD_SCK_PIN  18
#define SD_CS_PIN   17
const int chipSelect = SD_CS_PIN;

#define PIN_ACCEL_X 26
#define PIN_ACCEL_Y 27
#define PIN_ACCEL_Z 28

// ==========================================
// 🎯 感測器物件與常量設定
// ==========================================
TinyGPSPlus gps;
#define GPS_I2C_ADDR 0x42

MS5611 ms5611(0x77);
Adafruit_LIS3MDL lis3mdl;
File dataFile;

const float ACTUAL_PICO_VOLTAGE = 3.30; 
const float ZERO_G_VOLTAGE = 1.260; 
const float SENSITIVITY    = 0.300; 

// u-blox M10 10Hz 設定指令
const byte SET_TO_10HZ[] = {
  0xB5, 0x62, 0x06, 0x08, 0x06, 0x00, 0x64, 0x00, 0x01, 0x00, 0x01, 0x00, 0x7A, 12
};

// ==========================================
// ⏱️ 時間排程時間軸與狀態變數
// ==========================================
unsigned long lastLogTime = 0; // 統一降速為 10Hz 時間軸 (100ms)

bool baroOnline = false;
bool magOnline  = false;

// 全域快取變數
float gX = 0, gY = 0, gZ = 0;
float magX = 0, magY = 0, magZ = 0;
float tempC = 0, pressHPa = 0;
int gpsSats = 0;
float gpsLat = 0.0, gpsLng = 0.0, gpsAlt = 0.0;
char gpsTimeBuf[16] = "00:00:00.00";

// 🔍 檢查 I2C 裝置是否在線
bool checkI2COnline(byte address) {
  Wire.beginTransmission(address);
  return (Wire.endTransmission() == 0);
}

void setup() {
  Serial.begin(115200);
  delay(1000); 

  Serial.println("\n--- 🚀 綜合黑盒子航電系統 (10Hz 順暢流暢版) 啟動 ---");

  // 1. 初始化 I2C0 總線並開啟 400kHz 高速模式
  Wire.setSDA(I2C_SDA_PIN);
  Wire.setSCL(I2C_SCL_PIN);
  Wire.begin(); 
  Wire.setClock(400000); 
  Serial.println(">> [I2C] 總線速度維持 400kHz Fast Mode (加速資料讀取)");

  // GPS 初始化
  Wire.beginTransmission(GPS_I2C_ADDR);
  Wire.write(SET_TO_10HZ, sizeof(SET_TO_10HZ));
  Wire.endTransmission();

  // 氣壓計初次上線
  ms5611.begin(); 
  baroOnline = checkI2COnline(0x77);

  // 地磁規初次上線
  if (lis3mdl.begin_I2C(0x1C, &Wire)) {
    lis3mdl.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
    lis3mdl.setOperationMode(LIS3MDL_CONTINUOUSMODE);
    lis3mdl.setRange(LIS3MDL_RANGE_4_GAUSS);
    magOnline = true;
  }

  // 設定 Pico 內建下拉電阻
  pinMode(PIN_ACCEL_X, INPUT_PULLDOWN);
  pinMode(PIN_ACCEL_Y, INPUT_PULLDOWN);
  pinMode(PIN_ACCEL_Z, INPUT_PULLDOWN);
  
  // 設定 Pico ADC 解析度 (12-bit)
  analogReadResolution(12);
  Serial.println(">> [加速規] 內建下拉電阻就緒");

  // 2. 初始化 SD 卡 SPI0
  SPI.setRX(SD_MISO_PIN);
  SPI.setTX(SD_MOSI_PIN);
  SPI.setSCK(SD_SCK_PIN);
  
  if (SD.begin(chipSelect)) {
    dataFile = SD.open("rocket.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.println("Runtime(ms),gX,gY,gZ,magX(uT),magY(uT),magZ(uT),Temp(C),Press(hPa),Sats,Lat,Lng,Alt(m),GPSTime(UTC)");
      dataFile.close();
      Serial.println(">> [SD卡] rocket.csv 標頭寫入成功！");
    }
  } else {
    Serial.println("❌ [警告] SD 卡未就緒！");
  }
}

void loop() {
  unsigned long currentMillis = millis();

  // 🔄 GPS 資料流解碼依舊保持即時接收（防止緩衝區溢位）
  if (checkI2COnline(GPS_I2C_ADDR)) {
    Wire.requestFrom(GPS_I2C_ADDR, 32);
    while (Wire.available()) {
      char c = Wire.read();
      if (c != (char)0xFF) {
        gps.encode(c);
      }
    }
  }

  // ==========================================
  // ⏱️ 核心排程：所有數據與寫入「同步降速」為 10Hz (每 100ms 執行一次)
  // ==========================================
  if (currentMillis - lastLogTime >= 30) { // 👈 這裡改成 100ms 囉！
    lastLogTime = currentMillis;

    // --- 1. 類比加速規讀取與丟失歸零 ---
    int rawX = analogRead(PIN_ACCEL_X);
    int rawY = analogRead(PIN_ACCEL_Y);
    int rawZ = analogRead(PIN_ACCEL_Z);

    float vX = rawX * (ACTUAL_PICO_VOLTAGE / 4095.0);
    float vY = rawY * (ACTUAL_PICO_VOLTAGE / 4095.0);
    float vZ = rawZ * (ACTUAL_PICO_VOLTAGE / 4095.0);

    // 配合下拉電阻或 4.7K 電阻的精準斷線判定
    if (vX + vY + vZ < 1.00) {
      gX = 0.0; gY = 0.0; gZ = 0.0;
    } else {
      gX = (vX - ZERO_G_VOLTAGE) / SENSITIVITY;
      gY = (vY - ZERO_G_VOLTAGE) / SENSITIVITY;
      gZ = (vZ - ZERO_G_VOLTAGE) / SENSITIVITY;
    }

    // --- 2. 地磁規讀取、熱插拔與丟失歸零 ---
    if (checkI2COnline(0x1C)) {
      if (!magOnline) { 
        if (lis3mdl.begin_I2C(0x1C, &Wire)) {
          lis3mdl.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
          lis3mdl.setOperationMode(LIS3MDL_CONTINUOUSMODE);
          lis3mdl.setRange(LIS3MDL_RANGE_4_GAUSS);
          magOnline = true;
        }
      }
      if (magOnline) {
        sensors_event_t event; 
        lis3mdl.getEvent(&event);
        magX = event.magnetic.x;
        magY = event.magnetic.y;
        magZ = event.magnetic.z;
      }
    } else {
      magOnline = false;
      magX = 0.0; magY = 0.0; magZ = 0.0;
    }

    // --- 3. 氣壓計讀取、熱插拔與丟失歸零 ---
    if (checkI2COnline(0x77)) {
      if (!baroOnline) {
        ms5611.begin();
        baroOnline = true;
      }
      ms5611.read();
      tempC = ms5611.getTemperature();
      pressHPa = ms5611.getPressure();
    } else {
      baroOnline = false;
      tempC = 0.0; pressHPa = 0.0;
    }

    // --- 4. GPS 快取更新 ---
    gpsSats = gps.satellites.value();
    if (gps.location.isValid() && checkI2COnline(GPS_I2C_ADDR)) {
      gpsLat = gps.location.lat();
      gpsLng = gps.location.lng();
      gpsAlt = gps.altitude.meters();
      sprintf(gpsTimeBuf, "%02d:%02d:%02d.%02d", gps.time.hour(), gps.time.minute(), gps.time.second(), gps.time.centisecond());
    } else {
      gpsLat = 0.0; gpsLng = 0.0; gpsAlt = 0.0;
      strcpy(gpsTimeBuf, "00:00:00.00");
    }

    // ==========================================
    // 🖥️ 輸出至 Serial Monitor (10Hz 溫和輸出)
    // ==========================================
    Serial.print("T:"); Serial.print(currentMillis);
    Serial.print("ms | Acc:"); Serial.print(gX,1); Serial.print(","); Serial.print(gY,1); Serial.print(","); Serial.print(gZ,1);
    Serial.print(" | Mag:"); Serial.print(magX,1); Serial.print(","); Serial.print(magY,1); Serial.print(","); Serial.print(magZ,1);
    Serial.print(" | Baro:"); Serial.print(tempC,1); Serial.print("C,"); Serial.print(pressHPa,1); Serial.print("hPa");
    Serial.print(" | GPS:"); Serial.print(gpsSats); Serial.print(" | Alt:"); Serial.print(gpsAlt,1); Serial.print("m | ");
    Serial.println(gpsTimeBuf);

    // ==========================================
    // 💾 實體寫入 SD 卡 (10Hz 穩定寫入)
    // ==========================================
    dataFile = SD.open("rocket.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.print(currentMillis); dataFile.print(",");
      dataFile.print(gX, 2); dataFile.print(",");
      dataFile.print(gY, 2); dataFile.print(",");
      dataFile.print(gZ, 2); dataFile.print(",");
      dataFile.print(magX, 2); dataFile.print(",");
      dataFile.print(magY, 2); dataFile.print(",");
      dataFile.print(magZ, 2); dataFile.print(",");
      dataFile.print(tempC, 2); dataFile.print(",");
      dataFile.print(pressHPa, 2); dataFile.print(",");
      dataFile.print(gpsSats); dataFile.print(",");
      dataFile.print(gpsLat, 6); dataFile.print(",");
      dataFile.print(gpsLng, 6); dataFile.print(",");
      dataFile.print(gpsAlt, 1); dataFile.print(",");
      dataFile.println(gpsTimeBuf);
      dataFile.close(); 
    }
  }
}
