#include <RadioLib.h>

// 🎯 地面接收站腳位配置
#define LORA_NSS  13
#define LORA_MOSI 15
#define LORA_MISO 12
#define LORA_SCK  14
#define LORA_RST  10
#define LORA_BSY  2
#define LORA_D1   3
#define LORA_RXE  7
#define LORA_TXE  6

SPIClassRP2040 LORA_SPI(spi1, LORA_MISO, LORA_NSS, LORA_SCK, LORA_MOSI);
LLCC68 radio = new Module(LORA_NSS, LORA_D1, LORA_RST, LORA_BSY, LORA_SPI);

void setup() {
  pinMode(LORA_TXE, OUTPUT);
  pinMode(LORA_RXE, OUTPUT);
  digitalWrite(LORA_TXE, LOW);
  digitalWrite(LORA_RXE, LOW);

  // ⚡ 鮑率改回你原本的 115200 確保相容性！
  Serial.begin(115200); 

  LORA_SPI.begin();
  
  // 必須與發射端參數完全一致：915.0MHz, 125kHz, SF9
  int state = radio.begin(915.0, 125.0, 9, 7);
  if (state == RADIOLIB_ERR_NONE) {
    radio.setSyncWord(0x34); 
    Serial.println(F("[SYSTEM] 地面站 Lora 初始化成功！持續監聽中..."));
  } else {
    Serial.print(F("[SYSTEM] Lora 初始化失敗，代碼: "));
    Serial.println(state);
    while (true); 
  }

  // 射頻開關控制：地面站長駐接收模式（RXE拉高，TXE拉低）
  digitalWrite(LORA_TXE, LOW);
  digitalWrite(LORA_RXE, HIGH);
}

void loop() {
  String receivedStr;
  
  // 檢查是否有無線電封包進來
  int state = radio.receive(receivedStr);

  if (state == RADIOLIB_ERR_NONE) {
    
    // 檢查密碼標頭
    if (receivedStr.startsWith("#REDUN_BBOX#")) {
      
      // 切掉標頭，留下純數據
      String realData = receivedStr.substring(12);

      // 尋找字串中的所有逗號進行欄位切分
      int commaIndex[12];
      int count = 0;
      for (int i = 0; i < realData.length(); i++) {
        if (realData.charAt(i) == ',') {
          if (count < 12) {
            commaIndex[count] = i;
            count++;
          }
        }
      }

      // 如果 13 個發射端欄位完整無缺
      if (count == 12) {
        // 拆解發射端透過 LoRa 傳過來的原始數據
        String ms       = realData.substring(0, commaIndex[0]);
        String ax       = realData.substring(commaIndex[0]+1, commaIndex[1]);
        String ay       = realData.substring(commaIndex[1]+1, commaIndex[2]);
        String az       = realData.substring(commaIndex[2]+1, commaIndex[3]);
        String mx       = realData.substring(commaIndex[3]+1, commaIndex[4]);
        String my       = realData.substring(commaIndex[4]+1, commaIndex[5]);
        String mz       = realData.substring(commaIndex[5]+1, commaIndex[6]);
        String press    = realData.substring(commaIndex[6]+1, commaIndex[7]);
        String alt      = realData.substring(commaIndex[7]+1, commaIndex[8]);
        String sats     = realData.substring(commaIndex[8]+1, commaIndex[9]);
        String lat      = realData.substring(commaIndex[9]+1, commaIndex[10]);
        String lng      = realData.substring(commaIndex[10]+1, commaIndex[11]);
        String gps_alt  = realData.substring(commaIndex[11]+1);

        // --- ⚙️ 資料加工與轉化 ---
        float f_mx = mx.toFloat();
        float f_my = my.toFloat();
        float orient = atan2(f_my, f_mx) * 180.0 / M_PI;

        unsigned long currentSec = millis() / 1000;
        int gpsHour = (currentSec / 3600) % 24;
        int gpsMin = (currentSec % 3600) / 60;
        int gpsSec = currentSec % 60;

        float gpsSpeed = 0.0; 
        String sdStatus = "1"; 
        float tempC = 25.0;

        // 🟢 雙保險：在電腦螢幕上顯示接收成功（如果你是用 Arduino 監控器看的話）
        // 如果是要接 Python，你可以忽略這行 debug 提示，它不會干擾乾淨的 CSV 解析
        // Serial.println(F("[OK] 成功接收並解析一筆航電封包！"));

        // ==========================================
        // 🖥️ 【100% 契合 Python 地面站的 16 欄位 CSV 輸出】
        // ==========================================
        Serial.print(tempC, 1);       Serial.print(","); // 1. Temp
        Serial.print(orient, 2);      Serial.print(","); // 2. Orient
        Serial.print(press);          Serial.print(","); // 3. Pressure
        Serial.print(alt);            Serial.print(","); // 4. Altitude
        Serial.print(ax);             Serial.print(","); // 5. Acc X
        Serial.print(ay);             Serial.print(","); // 6. Acc Y
        Serial.print(az);             Serial.print(","); // 7. Acc Z
        Serial.print(sdStatus);       Serial.print(","); // 8. SD Status
        Serial.print(lng);            Serial.print(","); // 9. Lon
        Serial.print(lat);            Serial.print(","); // 10. Lat
        Serial.print(gps_alt);        Serial.print(","); // 11. GPS Alt
        Serial.print(gpsSpeed, 1);    Serial.print(","); // 12. GPS Speed
        Serial.print(sats);           Serial.print(","); // 13. GPS Sats
        Serial.print(gpsHour);        Serial.print(","); // 14. Hour
        Serial.print(gpsMin);         Serial.print(","); // 15. Minute
        Serial.println(gpsSec);                          // 16. Second
      }
    }
  }
}
