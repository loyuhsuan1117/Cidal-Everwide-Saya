#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BMP3XX.h>

// ===== 硬體定義 =====
#define DEPLOY_PIN 6      // 開傘觸發引腳
Adafruit_BMP3XX bmp;

// ===== 測試用參數 (室內模擬專用) =====
const float ARMING_ALT = 1.5;       // 超過 1.5 公尺即進入高頻追蹤
const float DROP_THRESHOLD = 0.5;   // 下降 0.5 公尺即觸發開傘

// ===== 全域變數 =====
float groundPressure = 0; 
float maxAlt = 0;         
float currentAlt = 0;     
unsigned long lastLog = 0;
int logInterval = 500;    // 初始 500ms (2Hz)

enum FlightState { STANDBY, ASCENT, APOGEE_HUNTING, DEPLOYED };
FlightState rocketState = STANDBY;

void setup() {
  Serial.begin(115200);
  pinMode(DEPLOY_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);

  // 初始化 I2C (ESP32 Pins 8, 9)
  Wire.begin(8, 9);
  
  if (!bmp.begin_I2C()) {
    Serial.println("❌ BMP390 啟動失敗");
    while (1);
  }

  // 設定硬體濾波器
  bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);
  bmp.setPressureOversampling(BMP3_OVERSAMPLING_4X);
  bmp.setIIRFilterCoeff(BMP3_IIR_FILTER_COEFF_3);

  // --- 關鍵：整合後的歸零校準邏輯 ---
  delay(2000); // 等待感測器穩定
  Serial.println("\n>>> 準備歸零，請放穩感測器不要移動...");
  
  float pSum = 0;
  int successCount = 0;
  
  // 連續取得 50 次正確讀數來取平均
  while (successCount < 50) {
    if (bmp.performReading()) {
      pSum += bmp.pressure / 100.0;
      successCount++;
      Serial.print("."); // 印出進度點
      if (successCount % 10 == 0) Serial.println(); 
      delay(20);
    }
  }
  
  groundPressure = pSum / 50.0;
  Serial.println("\n✅ 校準完成！現在高度歸零。");
  Serial.print("基準地面氣壓為: ");
  Serial.print(groundPressure);
  Serial.println(" hPa");
  Serial.println("--- 測試開始，請嘗試舉高感測器 ---");
}

void loop() {
  if (millis() - lastLog >= logInterval) {
    lastLog = millis();

    // 1. 取得相對高度
    if (bmp.performReading()) {
      float p = bmp.pressure / 100.0;
      // 使用剛剛鎖定的地面壓計算高度差
      currentAlt = 44330.0 * (1.0 - pow((p / groundPressure), 0.1903));
    }

    // 2. 測試狀態機邏輯
    switch (rocketState) {
      case STANDBY:
        if (currentAlt > 0.4) { // 稍微舉高就視為啟動
          rocketState = ASCENT;
          Serial.println("\n[狀態] 🚀 偵測到上升！");
        }
        break;

      case ASCENT:
        if (currentAlt > maxAlt) maxAlt = currentAlt;
        // 舉高超過 1.5m 模擬 800m 警戒
        if (currentAlt > ARMING_ALT) {
          rocketState = APOGEE_HUNTING;
          logInterval = 50; // 切換至 20Hz 高頻
          Serial.println("[狀態] ⚠️ 已達門檻，進入高頻追蹤模式...");
        }
        break;

      case APOGEE_HUNTING:
        if (currentAlt > maxAlt) maxAlt = currentAlt;
        
        // 核心判斷：從最高點掉下來 0.5m
        if ((maxAlt - currentAlt) > DROP_THRESHOLD) {
          fireParachute();
        }
        break;

      case DEPLOYED:
        logInterval = 1000; // 開傘後降頻
        break;
    }

    // 3. Serial Monitor 輸出
    Serial.print("高度: "); Serial.print(currentAlt, 2);
    Serial.print(" m | 最高: "); Serial.print(maxAlt, 2);
    Serial.print(" m | 狀態碼: "); Serial.println(rocketState);
  }
}

void fireParachute() {
  digitalWrite(DEPLOY_PIN, HIGH); 
  rocketState = DEPLOYED;
  Serial.println("\n************************************");
  Serial.println("* ！！！ [偵測到頂點：觸發開傘] ！！！    *");
  Serial.println("************************************\n");
}
