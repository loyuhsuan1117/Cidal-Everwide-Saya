#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BMP3XX.h>

// ===== 硬體定義 =====
#define DEPLOY_PIN 6      // 開傘觸發引腳
Adafruit_BMP3XX bmp;

// ===== 測試用門檻 (專為室內/電梯測試調整) =====
const float ARMING_ALT = 1.5;       // 超過 1.5 公尺即進入高頻追蹤 (模擬 800m)
const float DROP_THRESHOLD = 0.5;   // 下降 0.5 公尺即觸發開傘 (模擬頂點下墜)

// ===== 全域變數 =====
float groundPressure = 0; 
float maxAlt = 0;         
float currentAlt = 0;     
unsigned long lastLog = 0;
int logInterval = 500;    // 初始 500ms

enum FlightState { STANDBY, ASCENT, APOGEE_HUNTING, DEPLOYED };
FlightState rocketState = STANDBY;

void setup() {
  Serial.begin(115200);
  pinMode(DEPLOY_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);

  // 初始化 I2C (ESP32 Pins 8, 9)
  Wire.begin(8, 9);
  
  if (!bmp.begin_I2C()) {
    Serial.println("❌ BMP390 啟動失敗");
    while (1);
  }

  // 設定硬體濾波器：減少室內氣壓微幅跳動
  bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);
  bmp.setPressureOversampling(BMP3_OVERSAMPLING_4X);
  bmp.setIIRFilterCoeff(BMP3_IIR_FILTER_COEFF_3);

  // --- 自動歸零：將當前 3 樓位置設為 0m ---
  Serial.println(">>> 正在進行歸零校準，請保持感測器靜止...");
  float pSum = 0;
  for(int i=0; i<30; i++) {
    if(bmp.performReading()) pSum += bmp.pressure / 100.0;
    delay(40);
  }
  groundPressure = pSum / 30.0; 
  Serial.printf("✅ 校準完成！基準氣壓: %.2f hPa\n", groundPressure);
}

void loop() {
  if (millis() - lastLog >= logInterval) {
    lastLog = millis();

    // 1. 取得相對高度
    if (bmp.performReading()) {
      float p = bmp.pressure / 100.0;
      // 計算相對於 groundPressure 的位移
      currentAlt = 44330.0 * (1.0 - pow((p / groundPressure), 0.1903));
    }

    // 2. 測試邏輯狀態機
    switch (rocketState) {
      case STANDBY:
        // 舉高超過 0.5m 視為啟動
        if (currentAlt > 0.5) {
          rocketState = ASCENT;
          Serial.println("🚀 [狀態] 偵測到上升！");
        }
        break;

      case ASCENT:
        if (currentAlt > maxAlt) maxAlt = currentAlt;
        // 到達 1.5m 模擬 800m 的警戒區
        if (currentAlt > ARMING_ALT) {
          rocketState = APOGEE_HUNTING;
          logInterval = 50; // 切換至高頻 (20Hz)
          Serial.println("⚠️ [狀態] 已達門檻，進入高頻捕捉...");
        }
        break;

      case APOGEE_HUNTING:
        if (currentAlt > maxAlt) maxAlt = currentAlt;
        
        // 核心判斷：是否比最高點下降了 0.5m
        if ((maxAlt - currentAlt) > DROP_THRESHOLD) {
          fireParachute();
        }
        break;

      case DEPLOYED:
        logInterval = 1000;
        break;
    }

    // 3. Serial Monitor 輸出 (方便你觀察數值)
    Serial.print("高度: "); Serial.print(currentAlt, 2);
    Serial.print(" | 最高: "); Serial.print(maxAlt, 2);
    Serial.print(" | 狀態: "); 
    if(rocketState == 0) Serial.println("待機");
    else if(rocketState == 1) Serial.println("上升中");
    else if(rocketState == 2) Serial.println("高頻追蹤");
    else Serial.println("已開傘");
  }
}

void fireParachute() {
  digitalWrite(DEPLOY_PIN, HIGH); 
  rocketState = DEPLOYED;
  Serial.println("\n******* [！！！觸發開傘！！！] *******\n");
}
