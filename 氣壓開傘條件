#include <Wire.h>
#include "SparkFunLSM6DS3.h"

#define DEPLOY_PIN 6
LSM6DS3 lsm6(I2C_MODE, 0x6A); 

// 飛行邏輯變數
bool isLaunched = false;
unsigned long launchTime = 0;
const unsigned long DEPLOY_DELAY = 18000; // 18秒開傘

// 起飛判定增強
unsigned long gForceStartTime = 0;
const int G_FORCE_DURATION = 100; // 必須持續超過 3g 達 100 毫秒

void setup() {
  Serial.begin(115200);
  pinMode(DEPLOY_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);

  Wire.begin(8, 9);
  if (lsm6.begin() != 0) {
    Serial.println("❌ LSM6DS3 啟動失敗");
    while (1);
  }
  Serial.println("✅ 系統就緒：等待持續 G 力觸發起飛...");
}

void loop() {
  // 1. 讀取加速規與計算 Total G
  float ax = lsm6.readFloatAccelX();
  float ay = lsm6.readFloatAccelY();
  float az = lsm6.readFloatAccelZ();
  
  // 修正：C++ 中相乘必須使用 * 號，不能直接寫兩次變數名
  float totalG = sqrt(ax * ax + ay * ay + az * az);

  // 2. 判定起飛 (加入連續時間驗證)
  if (!isLaunched) {
    if (totalG > 3) {
      if (gForceStartTime == 0) {
        gForceStartTime = millis(); // 開始計時 G 力持續時間
      }

      // 如果持續時間超過 100ms
      if (millis() - gForceStartTime >= G_FORCE_DURATION) {
        isLaunched = true;
        launchTime = millis(); 
        Serial.println("\n🚀 [正式起飛] 偵測到持續推力，計時器啟動！");
      }
    } else {
      gForceStartTime = 0; // 如果 G 力中斷，重置計時
    }
  }

  // 3. 處理起飛後的計時開傘
  if (isLaunched) {
    unsigned long elapsedTime = millis() - launchTime;

    // 每秒輸出狀態
    static unsigned long lastPrint = 0;
    unsigned long currentSeconds = elapsedTime / 1000;

    if (currentSeconds != lastPrint) {
      lastPrint = currentSeconds;
      // 修正：原先的 lastCount 應改為 lastPrint 或 currentSeconds
      if (lastPrint <= 18) {
          Serial.printf("T + %lu 秒\n", lastPrint);
      }
    }

    // 到達 18 秒開傘
    if (elapsedTime >= DEPLOY_DELAY) {
      fireParachute();
    }
  }

  delay(20); // 提高採樣頻率到 50Hz 以捕捉細微變化
}

void fireParachute() {
  digitalWrite(DEPLOY_PIN, HIGH);
  Serial.println("\n** [T+18s：執行開傘指令] ***\n");
  while(1); 
}
