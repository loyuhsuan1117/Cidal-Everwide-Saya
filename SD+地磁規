#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_Sensor.h>

const int chipSelect = BUILTIN_SDCARD; 
Adafruit_LIS3MDL lis;
const char* fileName = "mag_data.csv";

// --- 新增變數：數據計數器 ---
unsigned long dataCount = 0; 

// 輔助函式：檢查檔案狀態並計算已有行數
void checkAndCreateFile() {
  if (!SD.exists(fileName)) {
    File dataFile = SD.open(fileName, FILE_WRITE);
    if (dataFile) {
      // 在標題列加入 "Index"
      dataFile.println("Index,Timestamp(ms),Mag_X(uT),Mag_Y(uT),Mag_Z(uT)");
      dataFile.close();
      Serial.println(F("建立新檔案並寫入標題。"));
      dataCount = 0; 
    }
  } else {
    // 如果檔案已存在，簡單掃描一下目前有幾筆（可選，避免重啟後編號歸零）
    File dataFile = SD.open(fileName, FILE_READ);
    if (dataFile) {
      while (dataFile.available()) {
        if (dataFile.read() == '\n') dataCount++;
      }
      dataFile.close();
      // 扣除標題列的一行
      if (dataCount > 0) dataCount--; 
      Serial.print(F("偵測到舊檔案，目前已有筆數: ")); Serial.println(dataCount);
    }
  }
}

void setup() {
  Serial.begin(115200);
  unsigned long startWait = millis();
  while (!Serial && (millis() - startWait < 2000)); 

  Serial.println(F("--- Teensy LIS3MDL 紀錄器 (含編號版) ---"));

  if (!lis.begin_I2C(0x1C)) {
    Serial.println(F("找不到 LIS3MDL！"));
    while (1) delay(10);
  }
  lis.setRange(LIS3MDL_RANGE_4_GAUSS);
  lis.setDataRate(LIS3MDL_DATARATE_155_HZ);
  lis.setPerformanceMode(LIS3MDL_HIGHMODE);
  lis.setOperationMode(LIS3MDL_CONTINUOUSMODE);

  if (!SD.begin(chipSelect)) {
    Serial.println(F("SD 卡啟動失敗！"));
  } else {
    Serial.println(F("SD 卡啟動成功。"));
    checkAndCreateFile();
  }
}

void loop() {
  sensors_event_t event;
  lis.getEvent(&event);

  // 每一圈計數器 +1
  dataCount++;

  // 螢幕輸出
  Serial.print(F("#")); Serial.print(dataCount);
  Serial.print(F(" | X: ")); Serial.print(event.magnetic.x);
  Serial.print(F(" Y: ")); Serial.print(event.magnetic.y);
  Serial.print(F(" Z: ")); Serial.println(event.magnetic.z);

  // --- 寫入 SD 卡 ---
  File dataFile = SD.open(fileName, FILE_WRITE);

  if (dataFile) {
    if (dataFile.size() == 0) {
      dataFile.println("Index,Timestamp(ms),Mag_X(uT),Mag_Y(uT),Mag_Z(uT)");
      dataCount = 1; // 如果是新開的檔，編號重設為 1
    }

    // 依照格式寫入
    dataFile.print(dataCount); // 寫入編號
    dataFile.print(",");
    dataFile.print(millis());
    dataFile.print(",");
    dataFile.print(event.magnetic.x, 4); dataFile.print(",");
    dataFile.print(event.magnetic.y, 4); dataFile.print(",");
    dataFile.println(event.magnetic.z, 4);

    dataFile.close(); 
  } else {
    Serial.println(F("SD 寫入失敗，嘗試重新連線..."));
    SD.begin(chipSelect);
  }

  delay(500); 
}
