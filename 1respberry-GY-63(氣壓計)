#include <Wire.h>
#include <MS5611.h>

// 宣告 MS5611 物件 (I2C 位址 0x77)
MS5611 ms5611(0x77);

void setup() {
  Serial.begin(115200);
  delay(2000); // 串口穩定時間

  Serial.println("--- GY-63 強制讀取測試 ---");

  // 設定 Pico 的 I2C 引腳
  Wire.setSDA(4);
  Wire.setSCL(5);
  Wire.begin();

  // 初始化
  ms5611.begin(); 
  
  Serial.println("✅ 初始化指令發送完畢，開始讀取...");
}

void loop() {
  // 直接讀取數據，不檢查回傳狀態碼
  ms5611.read();
  
  // 取得數據
  float temp = ms5611.getTemperature();
  float press = ms5611.getPressure();
  
  // 輸出結果
  Serial.print("溫度: "); 
  Serial.print(temp, 2); 
  Serial.print(" C | ");
  Serial.print("氣壓: "); 
  Serial.print(press, 2); 
  Serial.println(" hPa");

  delay(500); // 每秒輸出一次
}
