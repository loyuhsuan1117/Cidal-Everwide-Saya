#include <Wire.h>
#include "LSM6DS3.h"

// 建立 LSM6DS3 物件
LSM6DS3 imu(I2C_MODE);

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22); // ESP32-S3 SDA/SCL

  if (imu.begin() != IMU_SUCCESS) {
    Serial.println("LSM6DS3 初始化失敗");
    while (1);
  }
  Serial.println("LSM6DS3 初始化成功");
}

void loop() {
  // 讀取加速度計
  float ax = imu.readFloatAccelX();
  float ay = imu.readFloatAccelY();
  float az = imu.readFloatAccelZ();

  // 讀取陀螺儀
  float gx = imu.readFloatGyroX();
  float gy = imu.readFloatGyroY();
  float gz = imu.readFloatGyroZ();

  Serial.print("ACC g: "); Serial.print(ax); Serial.print(", "); Serial.print(ay); Serial.print(", "); Serial.println(az);
  Serial.print("GYRO dps: "); Serial.print(gx); Serial.print(", "); Serial.print(gy); Serial.print(", "); Serial.println(gz);
  Serial.println("-----------------");

  delay(100);
}
