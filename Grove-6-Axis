#include <Wire.h>

#define LSM6DS3_ADDR 0x6A

#define WHO_AM_I 0x0F
#define CTRL1_XL 0x10
#define CTRL2_G  0x11
#define OUTX_L_XL 0x28
#define OUTX_L_G  0x22

void setup() {
  Serial.begin(115200);
  Wire.begin();
  delay(100);

  // 檢查 WHO_AM_I
  uint8_t id = readRegister(WHO_AM_I);
  if (id != 0x69) {
    Serial.println("ERROR: LSM6DS3 not found!");
    while(1);
  }
  Serial.println("LSM6DS3 detected!");

  // 初始化加速度
  writeRegister(CTRL1_XL, 0x42);
  // 初始化陀螺儀
  writeRegister(CTRL2_G, 0x4C);

  Serial.println("time_ms,ax,ay,az,gx,gy,gz");
}

void loop() {
  unsigned long t = millis();

  float ax = readAxis(OUTX_L_XL) * 0.061 / 1000.0;
  float ay = readAxis(OUTX_L_XL + 2) * 0.061 / 1000.0;
  float az = readAxis(OUTX_L_XL + 4) * 0.061 / 1000.0;

  float gx = readAxis(OUTX_L_G) * 0.07 / 1000.0;
  float gy = readAxis(OUTX_L_G + 2) * 0.07 / 1000.0;
  float gz = readAxis(OUTX_L_G + 4) * 0.07 / 1000.0;

  Serial.print(t); Serial.print(",");
  Serial.print(ax,3); Serial.print(",");
  Serial.print(ay,3); Serial.print(",");
  Serial.print(az,3); Serial.print(",");
  Serial.print(gx,3); Serial.print(",");
  Serial.print(gy,3); Serial.print(",");
  Serial.println(gz,3);

  delay(200);
}

void writeRegister(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(LSM6DS3_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

uint8_t readRegister(uint8_t reg) {
  Wire.beginTransmission(LSM6DS3_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(LSM6DS3_ADDR, (uint8_t)1);
  return Wire.read();
}

int16_t readAxis(uint8_t reg) {
  Wire.beginTransmission(LSM6DS3_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(LSM6DS3_ADDR, (uint8_t)2);
  uint8_t l = Wire.read();
  uint8_t h = Wire.read();
  return (int16_t)(h << 8 | l);
}
