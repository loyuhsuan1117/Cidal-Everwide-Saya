#include <SPI.h>
#include <SD.h>

// ==========================================
// 🚀 根據實測電壓校準後的航電參數
// ==========================================
const float ACTUAL_PICO_VOLTAGE = 3.30; 

// 依據你的實測：X, Y 靜止時為 1.26V (0g 零點)；Z 軸受重力上升至 1.55V (差值約 0.30V 代表 1g)
const float ZERO_G_VOLTAGE = 1.260; // 完美的 0g 基準電壓
const float SENSITIVITY    = 0.300; // 完美的靈敏度 (300mV/g)

// ==========================================
// 🌟 PCB 腳位設定 (SPI0 組合 A)
// ==========================================
#define SD_MISO_PIN 16
#define SD_MOSI_PIN 19
#define SD_SCK_PIN  18
#define SD_CS_PIN   17
const int chipSelect = SD_CS_PIN;

File dataFile;

void setup() {
  Serial.begin(115200);
  
  // 設定 Pico 的 ADC 為 12-bit 解析度 (0 - 4095)
  analogReadResolution(12);
  
  Serial.println("--- 🚀 超級黑盒子航電系統（數據校準完畢）啟動 ---");

  // 初始化 SD 卡的 SPI0 介面與腳位
  SPI.setRX(SD_MISO_PIN);
  SPI.setTX(SD_MOSI_PIN);
  SPI.setSCK(SD_SCK_PIN);
  
  Serial.print(">> 正在初始化 SD 卡... ");
  if (!SD.begin(chipSelect)) {
    Serial.println("❌ 失敗！請檢查卡片。");
  } else {
    Serial.println("✅ 成功！");
    
    // 建立新檔案並寫入 CSV 標頭
    dataFile = SD.open("accelbox.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.println("Runtime(ms),gX,gY,gZ");
      dataFile.close();
      Serial.println(">> 已建立日誌檔 accelbox.csv 並寫入 CSV 欄位標頭");
    }
  }
}

void loop() {
  // 每 10 毫秒 (100Hz) 紀錄並印出一筆資料
  static unsigned long lastLog = 0;
  unsigned long currentMillis = millis();

  if (currentMillis - lastLog >= 10) { 
    lastLog = currentMillis;

    // 1. 讀取原始 ADC 值
    int rawX = analogRead(26);
    int rawY = analogRead(27);
    int rawZ = analogRead(28);

    // 2. 轉換為實際電壓
    float vX = rawX * (ACTUAL_PICO_VOLTAGE / 4095.0);
    float vY = rawY * (ACTUAL_PICO_VOLTAGE / 4095.0);
    float vZ = rawZ * (ACTUAL_PICO_VOLTAGE / 4095.0);

    // 3. 套用客製化校準公式，精準轉換為 G 值
    float gX = (vX - ZERO_G_VOLTAGE) / SENSITIVITY;
    float gY = (vY - ZERO_G_VOLTAGE) / SENSITIVITY;
    float gZ = (vZ - ZERO_G_VOLTAGE) / SENSITIVITY;

    // 4. 序列埠監控器同步輸出 (此時數值應該會非常漂亮了！)
    Serial.print("TIME: "); Serial.print(currentMillis);
    Serial.print(" ms | X: "); Serial.print(gX, 2); Serial.print(" g");
    Serial.print(" | Y: "); Serial.print(gY, 2); Serial.print(" g");
    Serial.print(" | Z: "); Serial.print(gZ, 2); Serial.println(" g");

    // 5. 同步寫入 SD 卡
    dataFile = SD.open("accelbox.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.print(currentMillis); dataFile.print(",");
      dataFile.print(gX, 2); dataFile.print(",");
      dataFile.print(gY, 2); dataFile.print(",");
      dataFile.println(gZ, 2);
      dataFile.close(); 
    }
  }
}
