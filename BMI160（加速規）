#include <DFRobot_BMI160.h>

DFRobot_BMI160 bmi160;
const int8_t i2c_addr = 0x68;
void setup(){
  Serial.begin(115200);
  delay(100);
  
  //init the hardware bmin160  
  if (bmi160.softReset() != BMI160_OK){
    Serial.println("reset false");
    while(1);
  }
  
  //set and init the bmi160 i2c address
  if (bmi160.I2cInit(i2c_addr) != BMI160_OK){
    Serial.println("init false");
    while(1);
  }
}

void loop(){  
  int i = 0;
  int rslt;
  int16_t accelGyro[6]={0}; 
  
  //get both accel and gyro data from bmi160
  //parameter accelGyro is the pointer to store the data
  rslt = bmi160.getAccelGyroData(accelGyro);
  if(rslt == 0){
  Serial.print("A[g]: ");
    Serial.print(accelGyro[3] / 16384.0); Serial.print(",");
    Serial.print(accelGyro[4] / 16384.0); Serial.print(",");
    Serial.print(accelGyro[5] / 16384.0); Serial.print("  ");
    
    Serial.print("G[dps]: ");
    Serial.print(accelGyro[0] * 3.14 / 180.0); Serial.print(",");
    Serial.print(accelGyro[1] * 3.14 / 180.0); Serial.print(",");
    Serial.print(accelGyro[2] * 3.14 / 180.0); 
    
    Serial.println(); // 換行，讓下一筆數據從新的一行開始
    }
  else{
    Serial.println("err");
  }
  delay(200);
  }
