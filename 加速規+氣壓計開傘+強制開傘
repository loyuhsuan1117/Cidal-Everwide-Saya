#include <Wire.h>
#include <SPI.h>
#include <LoRa.h>
#include "SparkFunLSM6DS3.h"
#include <Adafruit_BMP3XX.h>

// ===== 硬體定義 =====
#define DEPLOY_PIN 6
#define LED_PIN 2
LSM6DS3 lsm6(I2C_MODE, 0x6A);
Adafruit_BMP3XX bmp;

// ===== 狀態變數 =====
bool isLaunched = false;
bool isDeployed = false;
unsigned long launchTime = 0;
const unsigned long DEPLOY_DELAY = 18000; // 18秒倒數

void setup() {
  Serial.begin(115200);
  pinMode(DEPLOY_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);

  Wire.begin(8, 9);
  SPI.begin(12, 13, 11, 10);
  LoRa.setPins(10, 9, 46);

  if (lsm6.begin() != 0) Serial.println("LSM6DS3 Error");
  if (!bmp.begin_I2C()) Serial.println("BMP390 Error");
  if (!LoRa.begin(925E6)) Serial.println("LoRa Error");

  Serial.println("✅ 系統啟動，等待起飛偵測...");
}

void loop() {
  if (isDeployed) return;

  // 1. 地面指令接收 (維持 FLASH_LIGHT 強制開傘)
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String cmd = "";
    while (LoRa.available()) cmd += (char)LoRa.read();
    if (cmd == "FLASH_LIGHT") {
      Serial.println("📡 [指令] 地面強制開傘！");
      fireParachute();
    }
  }

  // 2. 加速規：偵測起飛 (測試時門檻設低一點，實飛設回 3.0)
  float ax = lsm6.readFloatAccelX();
  float ay = lsm6.readFloatAccelY();
  float az = lsm6.readFloatAccelZ();
  float totalG = sqrt(ax*ax + ay*ay + az*az);

  if (!isLaunched && totalG > 1.2) { // 測試用門檻 1.2
    isLaunched = true;
    launchTime = millis();
    Serial.println("🚀 [起飛] 偵測到起飛，啟動 18 秒倒數...");
  }

  // 3. 處理起飛後的計時開傘
  if (isLaunched) {
    unsigned long elapsedTime = millis() - launchTime;
    
    // 顯示倒數資訊
    static unsigned long lastPrint = 0;
    if (elapsedTime / 1000 != lastPrint) {
      lastPrint = elapsedTime / 1000;
      Serial.printf("T + %lu 秒\n", lastPrint);
    }

    if (elapsedTime >= DEPLOY_DELAY) {
      Serial.println("⏰ [時間到] 執行開傘！");
      fireParachute();
    }
  }
}

void fireParachute() {
  if (isDeployed) return;
  isDeployed = true;
  digitalWrite(DEPLOY_PIN, HIGH);
  digitalWrite(LED_PIN, HIGH);
  Serial.println("🔥 [執行] 開傘程序！");
  delay(5000); 
  digitalWrite(DEPLOY_PIN, LOW);
  digitalWrite(LED_PIN, LOW);
}
