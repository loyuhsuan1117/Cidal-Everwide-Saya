#include <Wire.h>
#include <SPI.h>
#include <LoRa.h>
#include "SparkFunLSM6DS3.h"

// ===== 硬體定義 =====
#define DEPLOY_PIN 6
#define LED_PIN 2
LSM6DS3 lsm6(I2C_MODE, 0x6A);

// ===== 飛行邏輯變數 =====
bool isLaunched = false;        // 是否已經起飛
bool isDeployed = false;       // 是否已經開傘
unsigned long launchTime = 0;  // 起飛時間點
const unsigned long DEPLOY_DELAY = 18000; // 18 秒 (單位：毫秒)

void setup() {
  Serial.begin(115200);
  pinMode(DEPLOY_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);

  // 初始化 I2C 與 SPI
  Wire.begin(8, 9);
  SPI.begin(12, 13, 11, 10);
  LoRa.setPins(10, 9, 46);

  if (lsm6.begin() != 0) Serial.println("LSM6DS3 啟動失敗");
  if (!LoRa.begin(925E6)) {
    Serial.println("LoRa 啟動失敗");
    while(1);
  }

  Serial.println("✅ 系統已就緒，等待起飛偵測 (G > 1.2)...");
}

void loop() {
  if (isDeployed) return; // 已經開傘，停止執行後續邏輯

  // 1. 地面指令接收 (維持 FLASH_LIGHT 強制開傘)
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String cmd = "";
    while (LoRa.available()) cmd += (char)LoRa.read();
    if (cmd == "FLASH_LIGHT") {
      Serial.println("📡 [地面指令] 強制執行開傘！");
      fireParachute();
    }
  }

  // 2. 加速規：偵測起飛
  float ax = lsm6.readFloatAccelX();
  float ay = lsm6.readFloatAccelY();
  float az = lsm6.readFloatAccelZ();
  float totalG = sqrt(ax*ax + ay*ay + az*az);

  // 測試用：若沒起飛且 G 力超過 1.2 則觸發起飛
  if (!isLaunched && totalG > 1.2) { 
    isLaunched = true;
    launchTime = millis();
    Serial.println("🚀 [起飛偵測] 偵測到推力，開始 18 秒倒數...");
  }

  // 3. 起飛後：處理倒數 18 秒
  if (isLaunched) {
    unsigned long elapsedTime = millis() - launchTime;
    
    // 每秒顯示剩餘時間 (方便除錯)
    static unsigned long lastSecond = 0;
    if (elapsedTime / 1000 != lastSecond) {
      lastSecond = elapsedTime / 1000;
      Serial.printf("T + %lu 秒\n", lastSecond);
    }

    // 時間到達 18 秒
    if (elapsedTime >= DEPLOY_DELAY) {
      Serial.println("⏰ [時間到] 執行自動開傘！");
      fireParachute();
    }
  }
}

void fireParachute() {
  if (isDeployed) return; // 防止重複觸發
  isDeployed = true;
  
  digitalWrite(DEPLOY_PIN, HIGH);
  digitalWrite(LED_PIN, HIGH);
  Serial.println("🔥 [執行] 開傘程序啟動！");
  
  delay(5000); // 動作持續 5 秒 (點火器/馬達)
  
  digitalWrite(DEPLOY_PIN, LOW);
  digitalWrite(LED_PIN, LOW);
  Serial.println("✅ 開傘程序完成。");
}
