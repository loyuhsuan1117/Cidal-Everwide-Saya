#include <Wire.h>
#include <SPI.h>
#include <LoRa.h>
#include "SparkFunLSM6DS3.h"
#include <Adafruit_BMP3XX.h>

// ===== 硬體定義 =====
#define DEPLOY_PIN 6
#define LED_PIN 2
LSM6DS3 lsm6(I2C_MODE, 0x6A);
Adafruit_BMP3XX bmp;

// ===== 飛行邏輯變數 =====
bool isLaunched = false;
bool isDeployed = false;
unsigned long launchTime = 0;
float baselineG = 1.0;             
const float G_THRESHOLD = 0.5;     
const unsigned long DEPLOY_DELAY = 18000; 

void setup() {
  Serial.begin(115200);
  pinMode(DEPLOY_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);

  Wire.begin(8, 9);
  SPI.begin(12, 13, 11, 10);
  LoRa.setPins(10, 9, 46);

  // 1. 強制感測器檢查：若沒接好則停止執行
  if (lsm6.begin() != 0) {
    Serial.println("❌ [錯誤] LSM6DS3 加速規未連接或接線錯誤！");
    while(1) { delay(1000); } // 鎖死程式，避免讀取雜訊
  }
  
  if (!bmp.begin_I2C()) Serial.println("⚠️ [警告] BMP390 氣壓計未連接");
  
  if (!LoRa.begin(925E6)) {
    Serial.println("❌ [錯誤] LoRa 初始化失敗");
    while(1) { delay(1000); }
  }

  // 2. 自動校準基準 G 值
  Serial.println(">>> 偵測到感測器！正在進行 G 值校準...");
  float sum = 0;
  for(int i = 0; i < 20; i++) {
    sum += sqrt(pow(lsm6.readFloatAccelX(), 2) + pow(lsm6.readFloatAccelY(), 2) + pow(lsm6.readFloatAccelZ(), 2));
    delay(50);
  }
  baselineG = sum / 20.0;
  Serial.printf("✅ 校準完成！基準 G 值: %.2f\n", baselineG);
  Serial.println("系統就緒，等待起飛偵測...");
}

void loop() {
  if (isDeployed) return;

  // 1. 地面指令接收
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String cmd = "";
    while (LoRa.available()) cmd += (char)LoRa.read();
    if (cmd == "FLASH_LIGHT") {
      Serial.println("📡 [地面指令] 強制開傘！");
      fireParachute();
    }
  }

  // 2. 加速規：偵測起飛 (排除雜訊)
  float totalG = sqrt(pow(lsm6.readFloatAccelX(), 2) + pow(lsm6.readFloatAccelY(), 2) + pow(lsm6.readFloatAccelZ(), 2));
  
  // 檢查是否超過門檻 (加入極簡單防抖動，數值必須大於 0.5 才算數)
  if (!isLaunched && (totalG - baselineG) > G_THRESHOLD) {
    isLaunched = true;
    launchTime = millis();
    Serial.println("🚀 [起飛偵測] 成功！開始 18 秒倒數...");
  }

  // 3. 起飛後倒數計時
  if (isLaunched) {
    unsigned long elapsedTime = millis() - launchTime;
    
    static unsigned long lastSecond = 0;
    if (elapsedTime / 1000 != lastSecond) {
      lastSecond = elapsedTime / 1000;
      Serial.printf("T + %lu 秒\n", lastSecond);
    }

    if (elapsedTime >= DEPLOY_DELAY) {
      Serial.println("⏰ [時間到] 自動開傘！");
      fireParachute();
    }
  }
}

void fireParachute() {
  if (isDeployed) return;
  isDeployed = true;
  
  digitalWrite(DEPLOY_PIN, HIGH);
  digitalWrite(LED_PIN, HIGH);
  Serial.println("🔥 [執行] 開傘程序啟動！");
  delay(5000); 
  digitalWrite(DEPLOY_PIN, LOW);
  digitalWrite(LED_PIN, LOW);
  Serial.println("✅ 開傘程序完成。");
}
