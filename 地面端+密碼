#include <SPI.h>
#include <LoRa.h>

// ===== 引腳定義 =====
#define LORA_CS    2
#define LORA_RST   0
#define LORA_DIO0  35

#define SCK     14
#define MISO    12
#define MOSI    13

void setup() {
  Serial.begin(115200);
  while (!Serial);

  Serial.println("--- LoRa 數據接收站 啟動 ---");

  // 初始化 SPI
  SPI.begin(SCK, MISO, MOSI, LORA_CS);

  // 初始化 LoRa
  LoRa.setPins(LORA_CS, LORA_RST, LORA_DIO0);

  if (!LoRa.begin(434.5E6)) { 
    Serial.println("❌ LoRa 初始化失敗，請檢查接線");
    while (1);
  }

  LoRa.setSyncWord(0x6B); 

  Serial.println("✅ LoRa 初始化成功，監聽中...");
}

void loop() {
  int packetSize = LoRa.parsePacket();

  if (packetSize) {
    // 1. 讀取封包內容並轉成字串
    String incoming = "";
    while (LoRa.available()) {
      incoming += (char)LoRa.read(); 
    }

    // --- 【修改點】強行檢查密碼標頭，如果不包含 #SUPER_BBOX# 則直接丟棄 ---
    if (incoming.startsWith("#SUPER_BBOX#")) {
      
      // 把密碼標頭切掉，只留下後面的火箭數據
      String realData = incoming.substring(12); 

      Serial.print(">>> [收到我方封包] 長度: ");
      Serial.print(packetSize);
      Serial.print(" bytes | RSSI: ");
      Serial.println(LoRa.packetRssi());

      Serial.print("內容數據: ");
      Serial.println(realData);

      Serial.println("----------------------------------");
    } else {
      // 這是別組漏進來的垃圾封包，直接不處理，連印都不印
    }
  }
}
