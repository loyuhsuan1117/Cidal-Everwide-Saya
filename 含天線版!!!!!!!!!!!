#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <SparkFun_u-blox_GNSS_Arduino_Library.h>
#include "LSM6DS3.h"           
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_BMP3XX.h>   
#include <Adafruit_Sensor.h>
#include <RadioLib.h> 

// --- 硬體定義：感測器與 SD ---
const int chipSelect = BUILTIN_SDCARD;
const char* fileName = "FLIGHT_LOG.csv";
#define BMP_SCK  13
#define BMP_MISO 12
#define BMP_MOSI 11
#define BMP_CS   10

// --- 硬體定義：LoRa-02 (SPI1) ---
#define LORA_CS   0
#define LORA_DIO0 25
#define LORA_RST  24
#define LORA_SCK  27
#define LORA_MISO 1
#define LORA_MOSI 26

// --- 物件實例化 ---
SFE_UBLOX_GNSS myGNSS;
LSM6DS3 myIMU(I2C_MODE, 0x6A); 
Adafruit_LIS3MDL lis;
Adafruit_BMP3XX bmp;

// LoRa 物件配置於 SPI1
SPIClass& spi1 = SPI1;
SPISettings loraSettings(2000000, MSBFIRST, SPI_MODE0);
SX1278 radio = new Module(LORA_CS, LORA_DIO0, LORA_RST, RADIOLIB_NC, spi1, loraSettings);

// --- 狀態與定時變數 ---
bool gpsOK = false, imuOK = false, lisOK = false, bmpOK = false, loraOK = false;
unsigned long lastRetry = 0;
unsigned long lastLoopTime = 0;
unsigned long dataCount = 0;
const unsigned long targetInterval = 500; // 2Hz (一秒兩筆)

float lastMagZ = 0;
int magStuckCount = 0;

// I2C 掃描工具
bool checkI2C(uint8_t addr) {
  Wire.beginTransmission(addr);
  return (Wire.endTransmission() == 0);
}

void tryRecover() {
  // 1. GPS (I2C)
  if (!gpsOK && checkI2C(0x42)) {
    if (myGNSS.begin()) {
      myGNSS.setI2COutput(COM_TYPE_UBX);
      myGNSS.setNavigationFrequency(2); 
      gpsOK = true;
    }
  }
  // 2. IMU (I2C)
  if (!imuOK && checkI2C(0x6A)) {
    if (myIMU.begin() == 0) imuOK = true;
  }
  // 3. MAG (I2C + 假死重置)
  if (!lisOK && (checkI2C(0x1C) || checkI2C(0x1E))) {
    if (lis.begin_I2C()) {
      lis.reset(); delay(50);
      lis.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
      lis.setOperationMode(LIS3MDL_CONTINUOUSMODE);
      lisOK = true;
    }
  }
  // 4. BMP390 (SPI0)
  if (!bmpOK) {
    if (bmp.begin_SPI(BMP_CS, BMP_SCK, BMP_MISO, BMP_MOSI)) {
      bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);
      bmpOK = true;
    }
  }
  // 5. LoRa (SPI1)
  if (!loraOK) {
    int state = radio.begin(433.0);
    if (state == RADIOLIB_ERR_NONE) loraOK = true;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  // 啟動 SPI1 (LoRa 專用)
  spi1.setMOSI(LORA_MOSI);
  spi1.setMISO(LORA_MISO);
  spi1.setSCK(LORA_SCK);
  spi1.begin();

  // 啟動 I2C
  Wire.begin();
  Wire.setClock(400000);

  if (SD.begin(chipSelect)) {
    File f = SD.open(fileName, FILE_WRITE);
    if (f) { f.println("Index,ms,SIV,Lat,Lon,Alt,AccZ,MagZ,Pres,LoRa"); f.close(); }
  }

  tryRecover();
  Serial.println(F("\n>>> Super Blackbox + LoRa Telemetry 啟動 <<<"));
}

void loop() {
  unsigned long currentTime = millis();

  if (currentTime - lastLoopTime >= targetInterval) {
    lastLoopTime = currentTime;

    // 每 2 秒檢查一次斷線設備
    if (currentTime - lastRetry > 2000) {
      tryRecover();
      lastRetry = currentTime;
    }

    float accZ = 0, magZ = 0, press = 0;
    double lat = 0, lon = 0, alt = 0;
    int siv = 0;

    // --- 數據採集 ---
    if (imuOK) {
      accZ = myIMU.readFloatAccelZ();
      if (isnan(accZ) || (accZ == 0 && !checkI2C(0x6A))) imuOK = false;
    }
    if (lisOK) {
      sensors_event_t m_e;
      lis.getEvent(&m_e);
      magZ = m_e.magnetic.z;
      if (magZ == lastMagZ && magZ != 0) magStuckCount++; else magStuckCount = 0;
      lastMagZ = magZ;
      if (magStuckCount > 5) lisOK = false;
    }
    if (bmpOK) {
      if (bmp.performReading()) press = bmp.pressure / 100.0; else bmpOK = false;
    }
    if (gpsOK && myGNSS.getPVT()) {
      siv = myGNSS.getSIV();
      lat = myGNSS.getLatitude()/10000000.0;
      lon = myGNSS.getLongitude()/10000000.0;
      alt = myGNSS.getAltitude()/1000.0;
    }

    dataCount++;

    // --- LoRa 無線電傳送 (每一秒兩次同步發射) ---
    if (loraOK) {
      // 格式：Index,衛星數,緯度,經度,高度
      String telemetry = String(dataCount) + "," + String(siv) + "," + 
                         String(lat, 6) + "," + String(lon, 6) + "," + String(alt, 1);
      radio.transmit(telemetry); 
    }

    // --- SD 卡本地紀錄 ---
    File df = SD.open(fileName, FILE_WRITE);
    if (df) {
      df.printf("%lu,%lu,%d,%.7f,%.7f,%.2f,%.2f,%.2f,%.2f,%d\n",
                dataCount, currentTime, siv, lat, lon, alt, accZ, magZ, press, loraOK);
      df.close();
    }

    // --- Serial 狀態監控 ---
    Serial.printf("#%-5lu | GPS:%c[%2d] | IMU:%c | MAG:%c | BAR:%c | LoRa:%c | %s\n", 
                  dataCount, gpsOK?'V':'X', siv, imuOK?'V':'X', 
                  lisOK?'V':'X', bmpOK?'V':'X', loraOK?'V':'X', 
                  loraOK ? "📡 發射中" : "⚠️ 斷訊");
  }
}
