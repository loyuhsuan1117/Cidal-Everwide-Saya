#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BMP3XX.h>
#include <LoRa.h>

// ===== 引腳定義 (依照你的 ESP32-S3 接法) =====
#define SD_CS      15
#define SD_SCK     14
#define SD_MISO    12
#define SD_MOSI    13

#define LORA_CS    2
#define LORA_RST   0
#define LORA_DIO0  35

// ===== 物件與設定 =====
Adafruit_BMP3XX bmp;
const char* filename = "/bmp_data.csv";
const float SEALEVELPRESSURE_HPA = 1013.25; // 請依當地氣壓調整

void setup() {
  Serial.begin(115200);
  
  // 核心引腳初始化
  pinMode(SD_CS, OUTPUT);
  pinMode(LORA_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);
  digitalWrite(LORA_CS, HIGH);

  Wire.begin(8, 9); // I2C 腳位

  // 1. 初始化 BMP390
  if (!bmp.begin_I2C()) {
    Serial.println("⚠️ BMP390 失敗");
    while (1);
  }
  bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);
  bmp.setPressureOversampling(BMP3_OVERSAMPLING_8X);
  bmp.setIIRFilterCoeff(BMP3_IIR_FILTER_COEFF_3);

  // 2. 初始化 SD 卡
  SPI.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);
  if (!SD.begin(SD_CS)) {
    Serial.println("❌ SD 卡失敗");
  } else {
    if (!SD.exists(filename)) {
      File dataFile = SD.open(filename, FILE_WRITE);
      if (dataFile) {
        dataFile.println("Time_ms,Temp_C,Press_hPa,Alt_m");
        dataFile.close();
      }
    }
    Serial.println("✅ SD 卡就緒");
  }

  // 3. 初始化 LoRa (433MHz)
  LoRa.setPins(LORA_CS, LORA_RST, LORA_DIO0);
  if (!LoRa.begin(433E6)) {
    Serial.println("❌ LoRa 失敗");
  } else {
    LoRa.setTxPower(17); // 設定發射功率
    Serial.println("✅ LoRa 就緒");
  }
}

void loop() {
  if (!bmp.performReading()) return;

  float temp = bmp.temperature;
  float press = bmp.pressure / 100.0;
  float alt = bmp.readAltitude(SEALEVELPRESSURE_HPA);

  // --- A. 格式化 LoRa 報告內容 (易讀格式) ---
  // 使用換行符號 \n 讓接收端顯示時自動換行
  String loraReport = "--- Data ---\n";
  loraReport += "Time: " + String(millis() / 1000) + "s\n";
  loraReport += "Temp: " + String(temp, 1) + " C\n";
  loraReport += "Pres: " + String(press, 1) + " hPa\n";
  loraReport += "Alt : " + String(alt, 1) + " m";

  // --- B. LoRa 發射 ---
  digitalWrite(SD_CS, HIGH); // 確保 SD 卡不干擾
  digitalWrite(LORA_CS, LOW);
  if (LoRa.beginPacket()) {
    LoRa.print(loraReport);
    LoRa.endPacket();
    Serial.println("📡 LoRa 傳送成功");
  }
  digitalWrite(LORA_CS, HIGH);

  // --- C. SD 卡紀錄 ---
  digitalWrite(LORA_CS, HIGH); // 確保 LoRa 不干擾
  digitalWrite(SD_CS, LOW);
  File dataFile = SD.open(filename, FILE_APPEND);
  if (dataFile) {
    dataFile.print(millis()); dataFile.print(",");
    dataFile.print(temp, 2);  dataFile.print(",");
    dataFile.print(press, 2); dataFile.print(",");
    dataFile.println(alt, 2);
    dataFile.close();
    Serial.print("💾 SD 紀錄成功 | ");
  }
  digitalWrite(SD_CS, HIGH);

  // 螢幕監控
  Serial.println(loraReport);
  Serial.println("-----------------");

  delay(1000); // 每秒執行一次
}
