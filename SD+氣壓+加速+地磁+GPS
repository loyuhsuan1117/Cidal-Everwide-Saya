#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <SparkFun_u-blox_GNSS_Arduino_Library.h>
#include "LSM6DS3.h"           // Grove 6-Axis
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_DPS310.h>
#include <Adafruit_Sensor.h>

// --- 硬體定義 ---
const int chipSelect = BUILTIN_SDCARD;
const char* fileName = "LOG_DATA.csv";

// --- 物件實例化 ---
SFE_UBLOX_GNSS myGNSS;
LSM6DS3 myIMU(I2C_MODE, 0x6A); 
Adafruit_LIS3MDL lis;
Adafruit_DPS310 dps;

// --- 狀態變數 ---
bool gpsOK = false, imuOK = false, lisOK = false, dpsOK = false;
unsigned long dataCount = 0;
unsigned long lastRetry = 0;

void setupSDCard() {
  if (!SD.begin(chipSelect)) {
    Serial.println(F("⚠️ SD 卡初始化失敗"));
    return;
  }
  if (!SD.exists(fileName)) {
    File f = SD.open(fileName, FILE_WRITE);
    if (f) {
      // 寫入 CSV 標題
      f.println("Index,ms,SIV,Lat,Lon,Alt,AccX,AccY,AccZ,MagX,MagY,MagZ,Temp,Press");
      f.close();
    }
  }
}

void initAllSensors() {
  // 1. GPS (0x42)
  if (!gpsOK && myGNSS.begin()) {
    myGNSS.setI2COutput(COM_TYPE_UBX);
    myGNSS.setNavigationFrequency(5);
    gpsOK = true;
  }
  // 2. Grove IMU (0x6A)
  if (!imuOK && myIMU.begin() == 0) imuOK = true;
  // 3. Mag (0x1C/0x1E)
  if (!lisOK && (lis.begin_I2C(0x1C) || lis.begin_I2C(0x1E))) {
    lis.setRange(LIS3MDL_RANGE_4_GAUSS);
    lisOK = true;
  }
  // 4. Baro (0x76)
  if (!dpsOK && dps.begin_I2C(0x76)) {
    dps.configurePressure(DPS310_64HZ, DPS310_64SAMPLES);
    dps.configureTemperature(DPS310_64HZ, DPS310_64SAMPLES);
    dpsOK = true;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000); // 給予 Serial Monitor 一點啟動時間

  Wire.begin();
  Wire.setClock(400000); // 400kHz 高速 I2C
  
  setupSDCard();
  initAllSensors();
  Serial.println(F("=== 紀錄系統 (無 LoRa 版) 啟動 ==="));
}

void loop() {
  unsigned long now = millis();
  
  // 每 2 秒嘗試重連斷線設備 (熱插拔保護)
  if (now - lastRetry > 2000) {
    initAllSensors();
    lastRetry = now;
  }

  // 數據變數初始化
  float ax=0, ay=0, az=0, magX=0, magY=0, magZ=0, temp=0, press=0;
  double lat=0, lon=0, alt=0;
  int siv = 0;
  sensors_event_t m_e, t_e, p_e;

  // --- 數據讀取邏輯 ---
  if (imuOK) {
    ax = myIMU.readFloatAccelX(); ay = myIMU.readFloatAccelY(); az = myIMU.readFloatAccelZ();
    if (isnan(ax)) imuOK = false;
  }
  if (lisOK) {
    if (lis.getEvent(&m_e)) {
      magX = m_e.magnetic.x; magY = m_e.magnetic.y; magZ = m_e.magnetic.z;
    } else { lisOK = false; }
  }
  if (dpsOK) {
    if (dps.getEvents(&t_e, &p_e)) {
      temp = t_e.temperature; press = p_e.pressure;
    } else { dpsOK = false; }
  }
  if (gpsOK) {
    if (myGNSS.getPVT()) {
      siv = myGNSS.getSIV();
      lat = myGNSS.getLatitude() / 10000000.0;
      lon = myGNSS.getLongitude() / 10000000.0;
      alt = myGNSS.getAltitude() / 1000.0;
    }
  }

  // --- 1. SD 卡寫入 ---
  dataCount++;
  File dataFile = SD.open(fileName, FILE_WRITE);
  if (dataFile) {
    dataFile.printf("%lu,%lu,%d,%.7f,%.7f,%.2f,%.3f,%.3f,%.3f,%.2f,%.2f,%.2f,%.2f,%.2f\n",
                    dataCount, now, siv, lat, lon, alt, ax, ay, az, magX, magY, magZ, temp, press);
    dataFile.close();
  }

  // --- 2. Serial Monitor 顯示 ---
  Serial.println(F("------------------------------------------------"));
  Serial.printf("#%-6lu | Time:%.1fs | ST:[G:%c I:%c M:%c B:%c]\n", 
                dataCount, now/1000.0, 
                gpsOK?'V':'X', imuOK?'V':'X', lisOK?'V':'X', dpsOK?'V':'X');
  
  if (imuOK) Serial.printf("  [IMU] Acc: X:%.3f Y:%.3f Z:%.3f (g)\n", ax, ay, az);
  if (lisOK) Serial.printf("  [MAG] Mag: X:%.1f Y:%.1f Z:%.1f (uT)\n", magX, magY, magZ);
  if (dpsOK) Serial.printf("  [ENV] %.2f C | %.2f hPa\n", temp, press);
  if (gpsOK) Serial.printf("  [GPS] SIV:%d | Pos:%.6f,%.6f | Alt:%.1f m\n", siv, lat, lon, alt);

  delay(200); // 5Hz 更新頻率
}
