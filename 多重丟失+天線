#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <TinyGPS++.h>
#include <MS5611.h>
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_Sensor.h>

// ==========================================
// 🌟 硬體腳位與引腳定義 (對齊新 PCB)
// ==========================================
#define I2C_SDA_PIN 4
#define I2C_SCL_PIN 5

#define SD_MISO_PIN 16
#define SD_MOSI_PIN 19
#define SD_SCK_PIN  18
#define SD_CS_PIN   17
const int chipSelect = SD_CS_PIN;

#define PIN_ACCEL_X 26
#define PIN_ACCEL_Y 27
#define PIN_ACCEL_Z 28

#define LORA_TX_PIN 12
#define LORA_RX_PIN 13

const int LORA_AUX = 2;         
const int BOARD_LED = 25;       

// ==========================================
// 🎯 感測器物件與常數設定 (🚀 三軸精密校準版)
// ==========================================
TinyGPSPlus gps;
#define GPS_I2C_ADDR 0x42

MS5611 ms5611(0x77);
Adafruit_LIS3MDL lis3mdl;
File dataFile;

const float ACTUAL_PICO_VOLTAGE = 3.30; 

// 👇 這是經過你實際正放、倒放、直立、倒立測量，完全消除硬體誤差的專屬參數
const float SENSITIVITY         = 0.05825; // 實測每 g 的電壓變化量
const float ZERO_G_VOLTAGE_X    = 0.2922;  // X 軸絕對零點
const float ZERO_G_VOLTAGE_Y    = 0.2983;  // Y 軸絕對零點
const float ZERO_G_VOLTAGE_Z    = 0.3087;  // Z 軸絕對零點

const byte SET_TO_10HZ[] = {
  0xB5, 0x62, 0x06, 0x08, 0x06, 0x00, 0x64, 0x00, 0x01, 0x00, 0x01, 0x00, 0x7A, 0x12
};

// ⏱️ 唯一的同步計時器
unsigned long lastSyncTime = 0; 
const unsigned long SYNC_INTERVAL = 200; // 🎯 200毫秒 (5Hz) 擷取與傳輸絕對同步

bool baroOnline = false;
bool magOnline  = false;
bool gpsOnline  = false; 

float gX = 0, gY = 0, gZ = 0;
float magX = 0, magY = 0, magZ = 0;
float tempC = 25.0, pressHPa = 1013.25; 
int gpsSats = 0;
float gpsLat = 0.0, gpsLng = 0.0, gpsAlt = 0.0;
char gpsTimeBuf[16] = "00:00:00.00";

bool checkI2COnline(byte address) {
  Wire.beginTransmission(address);
  return (Wire.endTransmission() == 0);
}

void setup() {
  pinMode(LORA_AUX, INPUT);
  pinMode(BOARD_LED, OUTPUT);

  Serial.begin(115200);
  unsigned long startWait = millis();
  while (!Serial && (millis() - startWait < 1500)); 

  Serial.println("\n--- 🚀 綜合航電 (精密校準同步版) 啟動 ---");
  
  // 初始化 PCB LoRa 串口
  Serial1.setTX(LORA_TX_PIN);
  Serial1.setRX(LORA_RX_PIN);
  Serial1.begin(9600); 
  delay(100);

  // ⚡ [E220 硬體天線加速] 確保空中速率拉滿到 62.5kbps
  byte SPEED_CMD[] = {0xC0, 0x00, 0x03, 0x00, 0x00, 0xE4}; 
  Serial1.write(SPEED_CMD, sizeof(SPEED_CMD));
  delay(200);

  // I2C 初始化
  Wire.setSDA(I2C_SDA_PIN);
  Wire.setSCL(I2C_SCL_PIN);
  Wire.begin(); 
  Wire.setClock(400000); 
  Wire.setTimeout(10); 

  delay(500); 
  if (checkI2COnline(GPS_I2C_ADDR)) {
    Wire.beginTransmission(GPS_I2C_ADDR);
    Wire.write(SET_TO_10HZ, sizeof(SET_TO_10HZ));
    Wire.endTransmission(); 
    gpsOnline = true;
  }

  ms5611.begin(); 
  baroOnline = checkI2COnline(0x77);

  if (lis3mdl.begin_I2C(0x1C, &Wire)) {
    lis3mdl.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
    lis3mdl.setOperationMode(LIS3MDL_CONTINUOUSMODE);
    lis3mdl.setRange(LIS3MDL_RANGE_4_GAUSS);
    magOnline = true;
  }

  pinMode(PIN_ACCEL_X, INPUT_PULLDOWN);
  pinMode(PIN_ACCEL_Y, INPUT_PULLDOWN);
  pinMode(PIN_ACCEL_Z, INPUT_PULLDOWN);
  analogReadResolution(12);

  SPI.setRX(SD_MISO_PIN); SPI.setTX(SD_MOSI_PIN); SPI.setSCK(SD_SCK_PIN);
  if (SD.begin(chipSelect)) {
    dataFile = SD.open("rocket.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.println("Runtime(ms),gX,gY,gZ,magX(uT),magY(uT),magZ(uT),Temp(C),Press(hPa),Sats,Lat,Lng,Alt(m),GPSTime(UTC)");
      dataFile.close();
    }
  }
}

void loop() {
  unsigned long currentMillis = millis();

  // GPS 背景即時解碼（必須在 loop 裡不斷跑，防止漏字）
  if (gpsOnline && checkI2COnline(GPS_I2C_ADDR)) {
    int bytesRead = 0;
    while (Wire.requestFrom(GPS_I2C_ADDR, 16) > 0 && bytesRead < 64) {
      while (Wire.available()) {
        char c = Wire.read();
        bytesRead++;
        if (c != (char)0xFF) gps.encode(c);
      }
    }
  }

  // ==========================================
  // ⏱️ 核心同步排程：5Hz (每200ms) 讀取 + 儲存 + 發射
  // ==========================================
  if (currentMillis - lastSyncTime >= SYNC_INTERVAL) { 
    lastSyncTime = currentMillis;

    // 1. 擷取類比加速規
    long sumX = 0, sumY = 0, sumZ = 0;
    for(int i = 0; i < 5; i++) {
      sumX += analogRead(PIN_ACCEL_X); sumY += analogRead(PIN_ACCEL_Y); sumZ += analogRead(PIN_ACCEL_Z);
      delayMicroseconds(5); 
    }
    float vX = (sumX / 5) * (ACTUAL_PICO_VOLTAGE / 4095.0);
    float vY = (sumY / 5) * (ACTUAL_PICO_VOLTAGE / 4095.0);
    float vZ = (sumZ / 5) * (ACTUAL_PICO_VOLTAGE / 4095.0);

    // 🛠️ 使用新放寬的防呆閾值 0.05
    if (vX < 0.05 || vY < 0.05 || vZ < 0.05) {
      gX = 0.0; gY = 0.0; gZ = 0.0;
    } else {
      gX = (vX - ZERO_G_VOLTAGE_X) / SENSITIVITY; 
      gY = (vY - ZERO_G_VOLTAGE_Y) / SENSITIVITY; 
      gZ = (vZ - ZERO_G_VOLTAGE_Z) / SENSITIVITY;
    }

    // 2. 擷取地磁規
    if (checkI2COnline(0x1C)) {
      if (!magOnline) { lis3mdl.begin_I2C(0x1C, &Wire); magOnline = true; }
      sensors_event_t event; lis3mdl.getEvent(&event);
      magX = event.magnetic.x; magY = event.magnetic.y; magZ = event.magnetic.z;
    } else {
      magOnline = false; magX = 0.0; magY = 0.0; magZ = 0.0;
    }

    // 3. 擷取氣壓計
    if (checkI2COnline(0x77)) {
      if (!baroOnline) { ms5611.begin(); baroOnline = true; }
      ms5611.read();
      float rawTemp = ms5611.getTemperature(); float rawPress = ms5611.getPressure();
      if (rawPress > 300.0 && rawTemp != 0.0) { tempC = rawTemp; pressHPa = rawPress; }
    } else {
      baroOnline = false; tempC = 0.0; pressHPa = 0.0;
    }

    // 4. 更新 GPS 數據
    if (gpsOnline) {
      gpsSats = gps.satellites.value();
      if (gps.location.isValid()) {
        gpsLat = gps.location.lat(); gpsLng = gps.location.lng(); gpsAlt = gps.altitude.meters();
        sprintf(gpsTimeBuf, "%02d:%02d:%02d.%02d", gps.time.hour(), gps.time.minute(), gps.time.second(), gps.time.centisecond());
      } else {
        gpsLat = 0.0; gpsLng = 0.0; gpsAlt = 0.0; strcpy(gpsTimeBuf, "00:00:00.00");
      }
    } else {
      gpsSats = -1;
    }

    // 🖥️ 1. 發射端本地端全數據暴噴
    Serial.print("T:"); Serial.print(currentMillis);
    Serial.print("ms | Acc:"); Serial.print(gX,1); Serial.print(","); Serial.print(gY,1); Serial.print(","); Serial.print(gZ,1);
    Serial.print(" | Mag:"); Serial.print(magX,1); Serial.print(","); Serial.print(magY,1); Serial.print(","); Serial.print(magZ,1);
    Serial.print(" | Baro:"); Serial.print(tempC,1); Serial.print("C,"); Serial.print(pressHPa,1); Serial.print("hPa");
    Serial.print(" | Sats:"); Serial.print(gpsSats);
    Serial.print(" | Lat:"); Serial.print(gpsLat, 6);
    Serial.print(" | Lng:"); Serial.print(gpsLng, 6);
    Serial.print(" | Alt:"); Serial.print(gpsAlt, 1); Serial.println("m");

    // 💾 2. 寫入 SD 卡
    dataFile = SD.open("rocket.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.print(currentMillis); dataFile.print(",");
      dataFile.print(gX, 2); dataFile.print(","); dataFile.print(gY, 2); dataFile.print(","); dataFile.print(gZ, 2); dataFile.print(",");
      dataFile.print(magX, 2); dataFile.print(","); dataFile.print(magY, 2); dataFile.print(","); dataFile.print(magZ, 2); dataFile.print(",");
      dataFile.print(tempC, 2); dataFile.print(","); dataFile.print(pressHPa, 2); dataFile.print(",");
      dataFile.print(gpsSats); dataFile.print(","); dataFile.print(gpsLat, 6); dataFile.print(","); dataFile.print(gpsLng, 6); dataFile.print(",");
      dataFile.print(gpsAlt, 1); dataFile.print(","); dataFile.println(gpsTimeBuf);
      dataFile.close(); 
    }

    // 📡 3. LoRa 傳輸完全同步 5Hz 噴射
    String loraBuffer = "";
    loraBuffer += String(currentMillis) + ",";
    loraBuffer += String(gX, 1) + "," + String(gY, 1) + "," + String(gZ, 1) + ",";
    loraBuffer += String(magX, 1) + "," + String(magY, 1) + "," + String(magZ, 1) + ","; 
    loraBuffer += String(tempC, 1) + "," + String(pressHPa, 1) + ",";
    loraBuffer += String(gpsSats) + ",";
    loraBuffer += String(gpsLat, 6) + "," + String(gpsLng, 6) + ","; 
    loraBuffer += String(gpsAlt, 1);
    
    Serial1.println(loraBuffer); 
    digitalWrite(BOARD_LED, HIGH); delayMicroseconds(20); digitalWrite(BOARD_LED, LOW);
  }
}
