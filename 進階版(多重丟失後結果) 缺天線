#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <SparkFun_u-blox_GNSS_Arduino_Library.h>
#include "LSM6DS3.h"           
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_BMP3XX.h>   
#include <Adafruit_Sensor.h>

// --- 硬體定義 ---
const int chipSelect = BUILTIN_SDCARD;
const char* fileName = "FLIGHT_LOG.csv";
#define BMP_SCK  13
#define BMP_MISO 12
#define BMP_MOSI 11
#define BMP_CS   10

// --- 物件實例化 ---
SFE_UBLOX_GNSS myGNSS;
LSM6DS3 myIMU(I2C_MODE, 0x6A); 
Adafruit_LIS3MDL lis;
Adafruit_BMP3XX bmp;

// --- 狀態與定時變數 ---
bool gpsOK = false, imuOK = false, lisOK = false, bmpOK = false;
unsigned long lastRetry = 0;
unsigned long lastLoopTime = 0;
unsigned long dataCount = 0;
const unsigned long targetInterval = 500; // 1秒2筆 (500ms)

// --- MAG 假死偵測變數 ---
float lastMagZ = 0;
int magStuckCount = 0;

// 檢查 I2C 設備是否在線上
bool checkI2C(uint8_t addr) {
  Wire.beginTransmission(addr);
  return (Wire.endTransmission() == 0);
}

void tryRecover() {
  // 1. GPS
  if (!gpsOK && checkI2C(0x42)) {
    if (myGNSS.begin()) {
      myGNSS.setI2COutput(COM_TYPE_UBX);
      myGNSS.setNavigationFrequency(2); 
      gpsOK = true;
    }
  }
  // 2. IMU
  if (!imuOK && checkI2C(0x6A)) {
    if (myIMU.begin() == 0) imuOK = true;
  }
  // 3. MAG (加強重置邏輯)
  if (!lisOK && (checkI2C(0x1C) || checkI2C(0x1E))) {
    if (lis.begin_I2C()) {
      lis.reset(); // 強制軟體重置晶片內部狀態
      delay(50);
      lis.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
      lis.setOperationMode(LIS3MDL_CONTINUOUSMODE);
      magStuckCount = 0;
      lisOK = true;
    }
  }
  // 4. BMP390 (SPI)
  if (!bmpOK) {
    if (bmp.begin_SPI(BMP_CS, BMP_SCK, BMP_MISO, BMP_MOSI)) {
      bmp.setTemperatureOversampling(BMP3_OVERSAMPLING_8X);
      bmp.setPressureOversampling(BMP3_OVERSAMPLING_4X);
      bmpOK = true;
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Wire.begin();
  Wire.setClock(400000);
  Wire.setTimeout(3000);

  if (SD.begin(chipSelect)) {
    File f = SD.open(fileName, FILE_WRITE);
    if (f) { f.println("Index,ms,SIV,Lat,Lon,Alt,AccZ,MagZ,Pres"); f.close(); }
  }
  tryRecover();
  Serial.println(F("\n>>> 終極防丟失監控系統 (2Hz) 啟動 <<<"));
}

void loop() {
  unsigned long currentTime = millis();

  if (currentTime - lastLoopTime >= targetInterval) {
    lastLoopTime = currentTime;

    if (currentTime - lastRetry > 2000) {
      tryRecover();
      lastRetry = currentTime;
    }

    float accZ = 0, magZ = 0, press = 0;
    double lat = 0, lon = 0, alt = 0;
    int siv = 0;

    // 1. IMU 讀取
    if (imuOK) {
      accZ = myIMU.readFloatAccelZ();
      if (isnan(accZ) || (accZ == 0.00 && !checkI2C(0x6A))) { imuOK = false; accZ = 0; }
    }

    // 2. MAG 讀取 (含假死偵測)
    if (lisOK) {
      sensors_event_t m_e;
      if (lis.getEvent(&m_e)) {
        magZ = m_e.magnetic.z;
        // 如果數值跟上一筆完全一樣且不是 0
        if (magZ == lastMagZ && magZ != 0) {
          magStuckCount++;
        } else {
          magStuckCount = 0; // 有變動，重置計數
        }
        lastMagZ = magZ;

        // 如果連續 5 筆（約 2.5 秒）沒變動，判定為假死
        if (magStuckCount > 5) { lisOK = false; magZ = 0; }
      } else { lisOK = false; magZ = 0; }
    }

    // 3. BAR 讀取
    if (bmpOK) {
      if (bmp.performReading()) {
        press = bmp.pressure / 100.0;
        if (press < 500.0 || press > 1200.0) { bmpOK = false; press = 0; }
      } else { bmpOK = false; press = 0; }
    }

    // 4. GPS 讀取
    if (gpsOK && myGNSS.getPVT()) {
      siv = myGNSS.getSIV();
      lat = myGNSS.getLatitude()/10000000.0;
      lon = myGNSS.getLongitude()/10000000.0;
      alt = myGNSS.getAltitude()/1000.0;
    }

    dataCount++;

    // SD 卡與 Serial 輸出
    File df = SD.open(fileName, FILE_WRITE);
    if (df) {
      df.printf("%lu,%lu,%d,%.7f,%.7f,%.2f,%.2f,%.2f,%.2f\n",
                dataCount, currentTime, siv, lat, lon, alt, accZ, magZ, press);
      df.close();
    }
    Serial.printf("#%-5lu | GPS:%c[%2d] | IMU:%c[%5.2f] | MAG:%c[%6.1f] | BAR:%c[%7.2f]\n", 
                  dataCount, gpsOK?'V':'X', siv, imuOK?'V':'X', accZ, lisOK?'V':'X', magZ, bmpOK?'V':'X', press);
  }
}
