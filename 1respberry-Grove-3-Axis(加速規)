#include <Wire.h>
#include <MS5611.h>
#include <LIS3DHTR.h> // 導入 Grove 加速度計函式庫

// 宣告感測器物件
MS5611 ms5611(0x77);
LIS3DHTR<TwoWire> accelerometer; // 宣告 LIS3DHTR 物件

#define SEALEVELPRESSURE_HPA (1013.25)

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000);

  Serial.println("--- 雙感測器測試啟動 (MS5611 + LIS3DHTR) ---");

  // 初始化 Pico 的預設 I2C 界面 (SDA=GPIO 4, SCL=GPIO 5)
  Wire.begin();

  // 1. 初始化 MS5611 氣壓計
  if (!ms5611.begin()) {
    Serial.println("❌ 錯誤：找不到 MS5611 氣壓計！");
    while (1) delay(10);
  }

  // 2. 初始化 Grove LIS3DHTR 加速度計
  accelerometer.begin(Wire, LIS3DHTR_DEFAULT_ADDRESS); 
  delay(100);
  
  // 設定加速度計採樣率與範圍 (修正後的正確參數)
  accelerometer.setOutputDataRate(LIS3DHTR_DATARATE_50HZ);
  accelerometer.setFullScaleRange(LIS3DHTR_RANGE_2G); // 修正：使用正確的列舉值

  Serial.println("✅ 所有感測器連線成功！開始讀取數據...");
  Serial.println("------------------------------------");
}

void loop() {
  static unsigned long lastDisplay = 0;

  if (millis() - lastDisplay > 2000) {
    lastDisplay = millis();

    // === 讀取 MS5611 數據 ===
    ms5611.read();
    float temperature = ms5611.getTemperature();
    float pressure = ms5611.getPressure();
    float altitude = 44330.0 * (1.0 - pow((pressure / SEALEVELPRESSURE_HPA), 0.1902949));

    // === 讀取 Grove 加速度計數據 ===
    float x = accelerometer.getAccelerationX();
    float y = accelerometer.getAccelerationY();
    float z = accelerometer.getAccelerationZ();

    // === 序列埠監控器輸出 ===
    Serial.print("系統時間: "); Serial.print(millis() / 1000); Serial.println(" 秒");
    
    // 氣壓計數據
    Serial.print("[MS5611] 溫度: "); Serial.print(temperature, 1); Serial.print(" *C  | ");
    Serial.print("氣壓: "); Serial.print(pressure, 1); Serial.print(" hPa  | ");
    Serial.print("高度: "); Serial.print(altitude, 1); Serial.println(" m");

    // 加速度計數據
    Serial.print("[Grove 3-Axis] X: "); Serial.print(x, 2);
    Serial.print(" G  | Y: "); Serial.print(y, 2);
    Serial.print(" G  | Z: "); Serial.print(z, 2); Serial.println(" G");

    Serial.println("------------------------------------------------");
  }
}
