/**
 * 類比加速度計完整測試程式
 * 接線：X->GP26, Y->GP27, Z->GP28, VCC->3.3V, GND->GND
 */

// --- 設定區 ---
// 這裡假設感測器在 0g 時輸出電壓為 1.65V (這是大多數類比加速度計的標準值)
const float ZERO_G_VOLTAGE = 1.65; 
// 靈敏度 (單位: V/g)。如果你的感測器靈敏度是 300mV/g，則填 0.3
const float SENSITIVITY = 0.300; 

void setup() {
  Serial.begin(115200);
  
  // 設定 Pico 的 ADC 為 12-bit 解析度
  analogReadResolution(12);
  
  Serial.println("--- 類比加速度計正式運行中 ---");
  delay(1000);
}

void loop() {
  // 讀取原始 ADC 值 (0 - 4095)
  int rawX = analogRead(26);
  int rawY = analogRead(27);
  int rawZ = analogRead(28);

  // 轉換為電壓 (3.3V / 4095)
  float vX = rawX * (3.3 / 4095.0);
  float vY = rawY * (3.3 / 4095.0);
  float vZ = rawZ * (3.3 / 4095.0);

  // 轉換為 G 值公式: G = (電壓 - 靜止電壓) / 靈敏度
  float gX = (vX - ZERO_G_VOLTAGE) / SENSITIVITY;
  float gY = (vY - ZERO_G_VOLTAGE) / SENSITIVITY;
  float gZ = (vZ - ZERO_G_VOLTAGE) / SENSITIVITY;

  // 輸出結果
  Serial.print("加速度 (g): ");
  Serial.print("X:"); Serial.print(gX, 2);
  Serial.print(" | Y:"); Serial.print(gY, 2);
  Serial.print(" | Z:"); Serial.println(gZ, 2);

  delay(200); // 更新頻率 5Hz
}
