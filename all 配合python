#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <TinyGPS++.h>
#include <MS5611.h>
#include <Adafruit_LIS3MDL.h>
#include <Adafruit_Sensor.h>
#include <math.h> 
#include <RadioLib.h> 

// ==========================================
// 🌟 硬體腳位與引腳定義 (RP2040 Pico)
// ==========================================
#define I2C_SDA_PIN 4
#define I2C_SCL_PIN 5

// SPI0 用於 SD 卡
#define SD_MISO_PIN 16
#define SD_MOSI_PIN 19
#define SD_SCK_PIN  18
#define SD_CS_PIN   17
const int chipSelect = SD_CS_PIN;

const int BOARD_LED = 25;

// 🎯 Ra-01SH 終極硬體腳位
#define LORA_NSS  13
#define LORA_MOSI 15
#define LORA_MISO 12
#define LORA_SCK  14
#define LORA_RST  10
#define LORA_BSY  2
#define LORA_D1   3
#define LORA_RXE  7
#define LORA_TXE  6

// ==========================================
// 🎯 感測器硬體暫存器與位址定義 (BMI160)
// ==========================================
#define BMI160_I2C_ADDR       0x68
#define BMI160_REG_CHIPID     0x00
#define BMI160_REG_ACC_DATA   0x12 
#define BMI160_REG_CMD        0x7E

TinyGPSPlus gps;
#define GPS_I2C_ADDR 0x42

MS5611 ms5611(0x77);
Adafruit_LIS3MDL lis3mdl;

File dataFile;

bool bmi160_Ready = false;
bool lis3mdl_Ready = false;
bool sd_Ready = false;
bool lora_Ready = false;

const float SEA_LEVEL_PRESSURE = 1013.25; 

const byte SET_TO_10HZ[] = {
  0xB5, 0x62, 0x06, 0x08, 0x06, 0x00, 0x64, 0x00, 0x01, 0x00, 0x01, 0x00, 0x7A, 0x12
};

// 🎯 使用自訂的 SPI1 初始化 Ra-01SH
SPIClassRP2040 LORA_SPI(spi1, LORA_MISO, LORA_NSS, LORA_SCK, LORA_MOSI);
LLCC68 radio = new Module(LORA_NSS, LORA_D1, LORA_RST, LORA_BSY, LORA_SPI);

// ==========================================
// ⏱️ 時間排程時間軸
// ==========================================
unsigned long lastAccelLog = 0; // 100Hz (10ms)
unsigned long lastMagLog   = 0; // 20Hz  (50ms)
unsigned long lastSlowLog  = 0; // 5Hz   (200ms)  <-- 🎯 這裡設定每秒5次

float gX = 0, gY = 0, gZ = 0;
float magX = 0, magY = 0, magZ = 0;
float tempC = 0, pressHPa = 0, baroAlt = 0; 
int gpsSats = 0;
float gpsLat = 0.0, gpsLng = 0.0, gpsAlt = 0.0;
float gpsSpeed = 0.0; 
char gpsTimeBuf[16] = "00:00:00.00";

// 時間欄位預設值
int gpsHour = 0;
int gpsMin = 0;
int gpsSec = 0;

// ==========================================
// 🧠 原生 I2C 讀寫底層函式
// ==========================================
void bmi160_WriteReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(BMI160_I2C_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

uint8_t bmi160_ReadReg(uint8_t reg) {
  Wire.beginTransmission(BMI160_I2C_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission() != 0) return 0xFF;
  
  Wire.requestFrom((uint8_t)BMI160_I2C_ADDR, (uint8_t)1);
  if (Wire.available()) return Wire.read();
  return 0xFF;
}

bool initBMI160_Direct() {
  uint8_t id = bmi160_ReadReg(BMI160_REG_CHIPID);
  if (id != 0xD1) return false; 
  
  bmi160_WriteReg(BMI160_REG_CMD, 0x11); 
  delay(50); 
  bmi160_WriteReg(0x41, 0x03);           
  delay(10);
  return true;
}

void setup() {
  pinMode(BOARD_LED, OUTPUT);
  pinMode(LORA_TXE, OUTPUT);
  pinMode(LORA_RXE, OUTPUT);
  digitalWrite(LORA_TXE, LOW);
  digitalWrite(LORA_RXE, LOW);

  Serial.begin(57600); 
  
  // 1. 初始化 I2C0 總線 (穩定 100kHz)
  Wire.setSDA(I2C_SDA_PIN);
  Wire.setSCL(I2C_SCL_PIN);
  Wire.begin(); 
  Wire.setClock(100000); 
  Wire.setTimeout(20);   

  Wire.beginTransmission(GPS_I2C_ADDR);
  Wire.write(SET_TO_10HZ, sizeof(SET_TO_10HZ));
  Wire.endTransmission();

  ms5611.begin(); 

  if (!lis3mdl.begin_I2C(0x1C, &Wire)) {          
    lis3mdl_Ready = false;
  } else {
    lis3mdl.setPerformanceMode(LIS3MDL_ULTRAHIGHMODE);
    lis3mdl.setOperationMode(LIS3MDL_CONTINUOUSMODE);
    lis3mdl.setRange(LIS3MDL_RANGE_4_GAUSS);
    lis3mdl_Ready = true;
  }

  if (!initBMI160_Direct()) {
    bmi160_Ready = false;
  } else {
    bmi160_Ready = true;
  }

  // ==========================================
  // 🎯 2. 初始化 SD 卡 (自訂 SPI0 引腳)
  // ==========================================
  SPI.setTX(SD_MOSI_PIN);
  SPI.setRX(SD_MISO_PIN);
  SPI.setSCK(SD_SCK_PIN);
  SPI.begin(); 

  if (!SD.begin(chipSelect)) {
    sd_Ready = false;
  } else {
    sd_Ready = true;
    dataFile = SD.open("redun.csv", FILE_WRITE);
    if (dataFile) {
      dataFile.println("Runtime(ms),gX,gY,gZ,magX(uT),magY(uT),magZ(uT),Temp(C),Press(hPa),BaroAlt(m),Sats,Lat,Lng,GpsAlt(m),GPSTime(UTC)");
      dataFile.close();
    }
  }

  // 3. 初始化 Ra-01SH (LLCC68) (SPI1)
  LORA_SPI.begin(); 
  
  int state = radio.begin(915.0, 125.0, 9, 7);
  if (state == RADIOLIB_ERR_NONE) {
    radio.setSyncWord(0x34); 
    lora_Ready = true;
    radio.setOutputPower(22); 
  }
}

void loop() {
  unsigned long currentMillis = millis();

  // GPS 接收流
  Wire.requestFrom(GPS_I2C_ADDR, 32);
  while (Wire.available()) {
    char c = Wire.read();
    if (c != (char)0xFF) gps.encode(c);
  }

  // ==========================================
  // 🕒 任務 1：100Hz (每 10ms) BMI160 原生直讀
  // ==========================================
  if (currentMillis - lastAccelLog >= 10) {
    lastAccelLog = currentMillis;

    if (bmi160_Ready) {
      Wire.beginTransmission(BMI160_I2C_ADDR);
      Wire.write(BMI160_REG_ACC_DATA); 
      
      if (Wire.endTransmission() == 0) {
        Wire.requestFrom((uint8_t)BMI160_I2C_ADDR, (uint8_t)6);
        if (Wire.available() >= 6) {
          int16_t rawX = (int16_t)(Wire.read() | (Wire.read() << 8));
          int16_t rawY = (int16_t)(Wire.read() | (Wire.read() << 8));
          int16_t rawZ = (int16_t)(Wire.read() | (Wire.read() << 8));
          
          gX = rawX / 16384.0;
          gY = rawY / 16384.0;
          gZ = rawZ / 16384.0;
        }
      }
    }
  }

  // ==========================================
  // 🕒 任務 2：20Hz (每 50ms) 地磁規採樣
  // ==========================================
  if (currentMillis - lastMagLog >= 50) {
    lastMagLog = currentMillis;

    if (lis3mdl_Ready) {
      sensors_event_t event; 
      lis3mdl.getEvent(&event);
      magX = event.magnetic.x;
      magY = event.magnetic.y;
      magZ = event.magnetic.z;
    } else {
      magX = 0.0; magY = 0.0; magZ = 0.0;
    }
  }

  // ==========================================
  // 🕒 任務 3：5Hz (每 200ms) 慢速感測器、儲存與無線電噴發
  // ==========================================
  if (currentMillis - lastSlowLog >= 200) {  
    lastSlowLog = currentMillis;

    ms5611.read();
    tempC = ms5611.getTemperature();                                   
    pressHPa = ms5611.getPressure();                                   
    baroAlt = 44330.0 * (1.0 - pow((pressHPa / SEA_LEVEL_PRESSURE), 0.1903)); 

    gpsSats = gps.satellites.value();
    if (gps.location.isValid()) {
      gpsLat = gps.location.lat();
      gpsLng = gps.location.lng();
      gpsAlt = gps.altitude.meters();
      gpsSpeed = gps.speed.mps(); 
      
      gpsHour = gps.time.hour();
      gpsMin = gps.time.minute();
      gpsSec = gps.time.second();
      sprintf(gpsTimeBuf, "%02d:%02d:%02d.%02d", gpsHour, gpsMin, gpsSec, gps.time.centisecond());
    } else {
      gpsLat = 0.0; gpsLng = 0.0; gpsAlt = 0.0; gpsSpeed = 0.0;
      strcpy(gpsTimeBuf, "SEARCHING");
      
      unsigned long sec = currentMillis / 1000;
      gpsHour = (sec / 3600) % 24;
      gpsMin = (sec % 3600) / 60;
      gpsSec = sec % 60;
    }

    // 📐 即時計算 Orientation (Yaw)
    float orient = 0.0;
    if (lis3mdl_Ready) {
      orient = atan2(magY, magX) * 180.0 / M_PI; 
    }

    // 🖥️ 專供 Python 解析的純 16 欄位 CSV 序列埠資料
    Serial.print(tempC, 2); Serial.print(",");
    Serial.print(orient, 2); Serial.print(",");
    Serial.print(pressHPa, 2); Serial.print(",");
    Serial.print(baroAlt, 2); Serial.print(",");
    Serial.print(gX, 3); Serial.print(",");
    Serial.print(gY, 3); Serial.print(",");
    Serial.print(gZ, 3); Serial.print(",");
    Serial.print(sd_Ready ? "1" : "0"); Serial.print(",");
    Serial.print(gpsLng, 6); Serial.print(",");
    Serial.print(gpsLat, 6); Serial.print(",");
    Serial.print(gpsAlt, 2); Serial.print(",");
    Serial.print(gpsSpeed, 2); Serial.print(",");
    Serial.print(gpsSats); Serial.print(",");
    Serial.print(gpsHour); Serial.print(",");
    Serial.print(gpsMin); Serial.print(",");
    Serial.println(gpsSec); 

    // 💾 SD 卡 CSV 完整存檔
    if (sd_Ready) {
      dataFile = SD.open("redun.csv", FILE_WRITE);
      if (dataFile) {
        dataFile.print(currentMillis); dataFile.print(",");
        dataFile.print(gX, 4); dataFile.print(",");
        dataFile.print(gY, 4); dataFile.print(",");
        dataFile.print(gZ, 4); dataFile.print(",");
        dataFile.print(magX, 2); dataFile.print(",");
        dataFile.print(magY, 2); dataFile.print(",");
        dataFile.print(magZ, 2); dataFile.print(",");
        dataFile.print(tempC, 2); dataFile.print(",");
        dataFile.print(pressHPa, 2); dataFile.print(","); 
        dataFile.print(baroAlt, 2); dataFile.print(","); 
        dataFile.print(gpsSats); dataFile.print(",");
        dataFile.print(gpsLat, 6); dataFile.print(",");
        dataFile.print(gpsLng, 6); dataFile.print(",");
        dataFile.print(gpsAlt, 1); dataFile.print(",");
        dataFile.println(gpsTimeBuf); 
        dataFile.close(); 
      }
    }

    // 📡 無線電遠程數據包噴發
    if (lora_Ready) {
      String telePacket = "#REDUN_BBOX#" + String(currentMillis) + "," + 
                          String(gX, 3) + "," + String(gY, 3) + "," + String(gZ, 3) + "," + 
                          String(magX, 1) + "," + String(magY, 1) + "," + String(magZ, 1) + "," + 
                          String(pressHPa, 1) + "," + String(baroAlt, 1) + "," + 
                          String(gpsSats) + "," + String(gpsLat, 6) + "," + String(gpsLng, 6) + "," + String(gpsAlt, 1);
      
      digitalWrite(LORA_RXE, LOW);
      digitalWrite(LORA_TXE, HIGH);
      
      radio.transmit(telePacket);
      
      digitalWrite(LORA_TXE, LOW);
    }

    digitalWrite(BOARD_LED, HIGH); delayMicroseconds(100); digitalWrite(BOARD_LED, LOW);
  }
}
