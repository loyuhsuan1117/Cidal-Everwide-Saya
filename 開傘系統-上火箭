#include <Wire.h>
#include <SPI.h>
#include <LoRa.h>
#include "SparkFunLSM6DS3.h"
#include <Adafruit_BMP3XX.h>

// ===== 【完全配合 PCB】開傘引腳鎖定在 GPIO 10 =====
#define DEPLOY_PIN 10  
#define LED_PIN 2

LSM6DS3 lsm6(I2C_MODE, 0x6A);
Adafruit_BMP3XX bmp;

bool isLaunched = false;
bool isDeployed = false;
unsigned long launchTime = 0;
float baselineG = 1.0;            
const float G_THRESHOLD = 0.5;     
const unsigned long DEPLOY_DELAY = 18000; 

void setup() {
  Serial.begin(115200);
  delay(1000); 
  
  pinMode(DEPLOY_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(DEPLOY_PIN, LOW);
  digitalWrite(LED_PIN, LOW);

  // 【完全配合 PCB】初始化 SPI：MISO=12, MOSI=13, SCK=14, NSS/CS=2
  SPI.begin(14, 12, 13, 2); // SCK, MISO, MOSI, SS
  
  // 【完全配合 PCB】設定 LoRa 專用腳位：NSS=2, RST=0, DIO0=35
  LoRa.setPins(2, 0, 35);   
  
  // 頻率對齊地面站的 433.5 MHz
  if (!LoRa.begin(433.5E6)) {
    Serial.println("❌ [硬體錯誤] LoRa 晶片啟動失敗，請檢查 PCB 上 2, 0, 35 腳位！");
    while(1) { digitalWrite(LED_PIN, HIGH); delay(100); digitalWrite(LED_PIN, LOW); delay(100); }
  }
  
  // 設定專屬同步字，過濾空中雜訊，與地面站一模一樣
  LoRa.setSyncWord(0x6B); 
  Serial.println("✅ LoRa 硬體初始化成功（433.5MHz / NSS=2 / DIO0=35）！");

  // 初始化 I2C 加速規 (SDA, SCL 維持你原本的 8, 9)
  Wire.begin(8, 9); 
  if (lsm6.begin() != 0) {
    Serial.println("❌ [硬體錯誤] LSM6DS3 未連接或 8, 9 腳位有誤！");
    while(1);
  }

  // 基準 G 值校準
  Serial.println(">>> 正在校準加速度計...");
  float sum = 0;
  for(int i = 0; i < 20; i++) {
    sum += sqrt(pow(lsm6.readFloatAccelX(), 2) + pow(lsm6.readFloatAccelY(), 2) + pow(lsm6.readFloatAccelZ(), 2));
    delay(30);
  }
  baselineG = sum / 20.0;
  Serial.printf("✅ 校準完成！基準 G 值: %.2f\n", baselineG);
  
  // 開機成功訊號：LED 閃爍三下
  for(int i=0; i<3; i++) {
    digitalWrite(LED_PIN, HIGH); delay(100);
    digitalWrite(LED_PIN, LOW);  delay(100);
  }
  Serial.println("🚀 火箭系統就緒！");
}

void loop() {
  // --- 優先權完全讓給無線電接收 ---
  int packetSize = LoRa.parsePacket();
  if (packetSize > 0) {
    String cmd = "";
    while (LoRa.available()) {
      cmd += (char)LoRa.read();
    }
    
    Serial.printf("📡 偵測到無線訊號！內容: [%s]\n", cmd.c_str());

    // 比對你指定的獨立開傘密碼標頭與清晰指令
    if (cmd.indexOf("#Cidal_Deploy#CMD:Eject_Parachute") >= 0) {
      Serial.println("🎯 [地面指令符合] 偵測到 #Cidal_Deploy#！強制執行開傘！");
      fireParachute();
      return; 
    }
  }

  // 如果已經開傘，卡死在這裡，保護現場
  if (isDeployed) {
    digitalWrite(LED_PIN, HIGH); 
    return;
  }

  // --- 大幅拉開加速規的讀取間隔，留出空檔給 LoRa 晶片處理中斷 ---
  static unsigned long lastAccelTime = 0;
  if (millis() - lastAccelTime > 100) { 
    lastAccelTime = millis();

    float ax = lsm6.readFloatAccelX();
    float ay = lsm6.readFloatAccelY();
    float az = lsm6.readFloatAccelZ();
    float totalG = sqrt(pow(ax, 2) + pow(ay, 2) + pow(az, 2));

    // 起飛偵測邏輯
    if (!isLaunched && (totalG - baselineG) > G_THRESHOLD) {
      isLaunched = true;
      launchTime = millis();
      Serial.printf("🚀 [起飛偵測] 成功！瞬間 G 值 %.2f，18秒自動開傘倒數開始...\n", totalG);
    }
  }

  // 倒數計時邏輯
  if (isLaunched) {
    unsigned long elapsedTime = millis() - launchTime;
    static unsigned long lastSecond = 0;
    
    if (elapsedTime / 1000 != lastSecond) {
      lastSecond = elapsedTime / 1000;
      Serial.printf("⏱️ T + %lu 秒\n", lastSecond);
    }
    
    if (elapsedTime >= DEPLOY_DELAY) {
      Serial.println("⏰ [時間到] 自動計時開傘！");
      fireParachute();
    }
  }

  delay(1); 
}

void fireParachute() {
  if (isDeployed) return;
  isDeployed = true;
  
  // 【完全配合 PCB】GPIO 10 輸出高電位觸發開傘
  Serial.println("🔥 [執行] 開傘！GPIO 10 導通，GPIO 2 燈亮！");
  digitalWrite(DEPLOY_PIN, HIGH);
  digitalWrite(LED_PIN, HIGH);     
  
  delay(5000); // 保持 5 秒開傘訊號輸出
  
  digitalWrite(DEPLOY_PIN, LOW);
  digitalWrite(LED_PIN, LOW);
  Serial.println("✅ 開傘程序結束。");
}
