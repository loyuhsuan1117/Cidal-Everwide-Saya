#include <Wire.h>
#include <SparkFunLSM9DS1.h>

LSM9DS1 imu;

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  if (!imu.begin()) {
    Serial.println("LSM9DS1 初始化失敗");
    while (1);
  }
  Serial.println("LSM9DS1 初始化成功");
}

void loop() {
  imu.readAccel();
  imu.readGyro();
  imu.readMag();

  float ax = imu.calcAccel(imu.ax);
  float ay = imu.calcAccel(imu.ay);
  float az = imu.calcAccel(imu.az);

  float gx = imu.calcGyro(imu.gx);
  float gy = imu.calcGyro(imu.gy);
  float gz = imu.calcGyro(imu.gz);

  float mx = imu.calcMag(imu.mx);
  float my = imu.calcMag(imu.my);
  float mz = imu.calcMag(imu.mz);

  Serial.print("ACC g: "); Serial.print(ax); Serial.print(", "); Serial.print(ay); Serial.print(", "); Serial.println(az);
  Serial.print("GYRO dps: "); Serial.print(gx); Serial.print(", "); Serial.print(gy); Serial.print(", "); Serial.println(gz);
  Serial.print("MAG gauss: "); Serial.print(mx); Serial.print(", "); Serial.print(my); Serial.print(", "); Serial.println(mz);
  Serial.println("-----------------");

  delay(100);
}
