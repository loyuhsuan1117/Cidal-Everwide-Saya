#include <Wire.h>
#include <Adafruit_LSM9DS1.h>
#include <Adafruit_Sensor.h>

// 建立感測器物件
Adafruit_LSM9DS1 lsm = Adafruit_LSM9DS1();

void setup() {
  // 1. 啟動序列埠並等待 (解決亂碼與沒看到東西的問題)
  Serial.begin(115200);
  unsigned long timeout = millis();
  while (!Serial && (millis() - timeout < 3000)); 
  Serial.println("\n--- 系統啟動中 ---");

  // 2. 指定 S3 的正確 I2C 腳位 (SDA=8, SCL=9)
  Wire.begin(4, 5); 

  // 3. 初始化感測器 (手動傳入 I2C 位址)
  // 如果 begin() 失敗，可以試著換成 lsm.begin(0x6B) 或 lsm.begin(0x6A)
  if (!lsm.begin()) {
    Serial.println("找不到 LSM9DS1，請檢查：");
    Serial.println("1. 線路：SDA接8, SCL接9, VCC接3.3V");
    Serial.println("2. 位址：某些模組需要指定 0x6B");
   //while (1) delay(10);
  }
  Serial.println("LSM9DS1 已連線！");

  lsm.setupAccel(lsm.LSM9DS1_ACCELRANGE_2G);
  lsm.setupMag(lsm.LSM9DS1_MAGGAIN_4GAUSS);
  lsm.setupGyro(lsm.LSM9DS1_GYROSCALE_245DPS);
}

void loop() {
  lsm.read(); 

  sensors_event_t a, m, g, temp;
  lsm.getEvent(&a, &m, &g, &temp);

  // 輸出加速度
  Serial.print("Accel X:"); Serial.print(a.acceleration.x); 
  Serial.print(" Y:"); Serial.print(a.acceleration.y);
  Serial.print(" Z:"); Serial.println(a.acceleration.z);

  // 輸出陀螺儀
  Serial.print("Gyro X:"); Serial.print(g.gyro.x);
  Serial.print(" Y:"); Serial.print(g.gyro.y);
  Serial.print(" Z:"); Serial.println(g.gyro.z);

  Serial.println("------------------------------------");
  delay(500);
}
