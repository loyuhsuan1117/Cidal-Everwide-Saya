#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_DPS310.h>

const int chipSelect = BUILTIN_SDCARD; 
Adafruit_DPS310 dps;
const char* fileName = "baro_data.csv";

// --- 數據計數器 ---
unsigned long dataCount = 0; 

// 輔助函式：檢查檔案並初始化編號（續傳邏輯）
void checkAndCreateFile() {
  if (!SD.exists(fileName)) {
    File dataFile = SD.open(fileName, FILE_WRITE);
    if (dataFile) {
      // 寫入標題：編號, 時間(ms), 溫度(C), 氣壓(hPa)
      dataFile.println("Index,Timestamp(ms),Temp(C),Pressure(hPa)");
      dataFile.close();
      Serial.println(F("建立新檔案並寫入標題。"));
      dataCount = 0;
    }
  } else {
    // 掃描舊檔案有幾行，確保重新斷電後編號能接著跳
    Serial.print(F("正在同步編號... "));
    File dataFile = SD.open(fileName, FILE_READ);
    if (dataFile) {
      while (dataFile.available()) {
        if (dataFile.read() == '\n') dataCount++;
      }
      dataFile.close();
      if (dataCount > 0) dataCount--; // 扣除第一行標題
      Serial.print(F("目前已紀錄筆數: ")); Serial.println(dataCount);
    }
  }
}

void setup() {
  Serial.begin(115200);
  unsigned long startWait = millis();
  while (!Serial && (millis() - startWait < 2000)); 

  Serial.println(F("--- Teensy DPS310 氣壓紀錄器 (編號續傳版) ---"));

  // 1. 初始化氣壓計
  if (!dps.begin_I2C(0x76)) {
    Serial.println(F("找不到 DPS310，請檢查接線！"));
    while (1) delay(10);
  }
  dps.configurePressure(DPS310_64HZ, DPS310_64SAMPLES);
  dps.configureTemperature(DPS310_64HZ, DPS310_64SAMPLES);
  Serial.println(F("DPS310 初始化完成！"));

  // 2. 初始化 SD 卡
  if (!SD.begin(chipSelect)) {
    Serial.println(F("SD 卡啟動失敗！"));
  } else {
    Serial.println(F("SD 卡啟動成功。"));
    checkAndCreateFile();
  }
}

void loop() {
  sensors_event_t temp_event, pressure_event;

  if (dps.getEvents(&temp_event, &pressure_event)) {
    // 數據計數加 1
    dataCount++;

    // 螢幕輸出
    Serial.print(F("#")); Serial.print(dataCount);
    Serial.print(F(" | Temp: ")); Serial.print(temp_event.temperature);
    Serial.print(F(" C | Pres: ")); Serial.print(pressure_event.pressure);
    Serial.println(F(" hPa"));

    // --- 寫入 SD 卡邏輯 ---
    File dataFile = SD.open(fileName, FILE_WRITE);

    if (dataFile) {
      // 萬一檔案在運行中途被電腦刪除，自動補回標題
      if (dataFile.size() == 0) {
        dataFile.println("Index,Timestamp(ms),Temp(C),Pressure(hPa)");
        dataCount = 1;
      }

      // 依照 CSV 格式寫入
      dataFile.print(dataCount);
      dataFile.print(",");
      dataFile.print(millis()); // 紀錄開機時間
      dataFile.print(",");
      dataFile.print(temp_event.temperature, 2);
      dataFile.print(",");
      dataFile.println(pressure_event.pressure, 2);

      dataFile.close(); // 存檔
    } else {
      // 如果寫入失敗，可能是 SD 卡接觸不良，嘗試重新啟動
      Serial.println(F("SD 寫入失敗，嘗試重新連線..."));
      SD.begin(chipSelect);
    }
  }

  delay(1000); // 氣壓計建議不需要太快，每秒更新一次即可
}
